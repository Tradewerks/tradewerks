# Port for server
SERVER_PORT="3000"

# DB Connection Info (Leave Default)
DB_HOST="db"
DB_PORT="5432"
DB_USER="hvac_user"
DB_PASS="hvac_pass"
DB_NAME="hvac_db"

# Prisma needs this. Connection string for your local postgres environment
DATABASE_URL="postgresql://[user]:[password]@localhost:5432/[name of db]"

FRONTEND_URL="http://localhost:5173"

# JWT Secret for auth and refresh tokens
JWT_ACCESS_SECRET="";
JWT_REFRESH_SECRET="";
OTP_SECRET="";

# MFA Encryption 
MFA_ENCRYPTION_KEY=

# SSO Keys
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Find the following info in Confluence
MAPBOX_TOKEN=""

WASABI_ACCESS=""
WASABI_SECRET=""
WASABI_BUCKET="dispatch"
WASABI_REGION="us-central-1"

POSTMARK_API_KEY=""
POSTMARK_FROM_EMAIL="corben@epicitautomations.com"
# Shared secret guarding /integrations/postmark/webhook (followup open/bounce
# tracking). Required in production — the webhook fails closed if unset.
# Generate with: openssl rand -hex 32
POSTMARK_WEBHOOK_SECRET=

# Max image upload size in MB (default: 15)
MAX_UPLOAD_MB=15

# Grafana Cloud Loki — log forwarding (optional; omit to disable)
# Find these in your Grafana Cloud stack under: Connections > Loki
# HOST is the base URL only, e.g. https://logs-prod-006.grafana.net
GRAFANA_CLOUD_LOKI_HOST=
GRAFANA_CLOUD_LOKI_USERNAME=
GRAFANA_CLOUD_LOKI_PASSWORD=

# Grafana Cloud OTLP — metrics push (optional; omit to disable)
# Connections > Add new connection > OpenTelemetry > Direct > generate a token
# Copy OTEL_EXPORTER_OTLP_ENDPOINT and the value of OTEL_EXPORTER_OTLP_HEADERS verbatim
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_OTLP_AUTH=

# QuickBooks integration 
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI="http://localhost:3000/integrations/quickbooks/callback"
QB_ENVIRONMENT="sandbox"
QB_WEBHOOK_VERIFIER_TOKEN=

RECEIPT_OCR_PROVIDER=mindee
MINDEE_API_KEY=
MINDEE_MODEL_ID=

# ── AI assistant (Phase 2) ───────────────────────────────────────────────────
# Omit OPENAI_API_KEY to ship with the assistant switched off: the backend boots
# normally, /assistant/status reports enabled=false, and the UI hides itself.
OPENAI_API_KEY=
# Set deliberately — naming a model the account cannot reach fails in front of a
# user mid-sentence rather than at boot. Must be a reasoning model: the loop
# always sends a reasoning effort, which a non-reasoning model rejects.
# gpt-5.6-luna is the default; gpt-5.6-terra is the escalation if the approval
# decline rate or the iteration_limit rate says the reasoning is not enough.
OPENAI_MODEL="gpt-5.6-luna"
# none | minimal | low | medium | high | xhigh | max (default low). Reasoning
# tokens bill at the output rate, so this is the main cost dial after the model.
# An unrecognised value falls back to low rather than taking the assistant down.
ASSISTANT_REASONING_EFFORT=
# Point at Azure OpenAI or a compatible gateway. Omit for api.openai.com.
OPENAI_BASE_URL=

# ── Review-first inventory imports ───────────────────────────────────────────
# Enables /inventory/imports and makes the legacy POST /inventory/import return
# 410 so stock changes cannot bypass review and approval.
INVENTORY_AI_IMPORT_ENABLED=false
# Draft undo deadline after a successful commit (default 30 minutes).
INVENTORY_IMPORT_UNDO_WINDOW_MINUTES=30
INVENTORY_IMPORT_MAX_FILES=20
INVENTORY_IMPORT_MAX_FILE_BYTES=10485760
INVENTORY_IMPORT_MAX_ROWS=10000
# Optional local persistent storage used when Wasabi is not configured.
INVENTORY_IMPORT_STORAGE_DIR=
# Optional extraction/mapping model; falls back to OPENAI_MODEL.
INVENTORY_IMPORT_OPENAI_MODEL=
# Model→tool→model round trips allowed inside one user turn (default 6)
ASSISTANT_MAX_ITERATIONS=
# Turns of history replayed to the model (default 40)
ASSISTANT_HISTORY_WINDOW=
# Ceiling on a single response (default 8000). Counts reasoning tokens as well
# as visible ones, so it cannot be sized against the answer alone — a turn that
# spends the whole budget thinking returns no text and reports OUTPUT_LIMIT.
# ASSISTANT_MAX_COMPLETION_TOKENS is still read as a fallback for old deploys.
ASSISTANT_MAX_OUTPUT_TOKENS=
# Concurrent in-flight replies one user may hold open (default 3)
ASSISTANT_MAX_CONCURRENT_STREAMS=
# Longest a single turn may run before the server gives up (ms, default 120000)
ASSISTANT_TURN_TIMEOUT_MS=
# Set to "false" to run the assistant read-only. Note that "writes enabled" is
# narrower than it sounds: every scheduling tool still stops for an explicit
# human approval, so this governs whether those tools are offered to the model
# at all — never whether it can act unattended.
ASSISTANT_WRITES_ENABLED=

# ── MCP server (local stdio) ─────────────────────────────────────────────────
# The account `npm run mcp` acts as. Establishes identity — which user, which
# org, which permissions — not access: the process already has DATABASE_URL.
MCP_USER_EMAIL=
MCP_USER_PASSWORD=
# Advertise write tools over MCP at all (default false)
MCP_WRITES_ENABLED=
# Let approval-gated tools (scheduling) actually run. Requires the above, and is
# a statement that your MCP client prompts before running a tool — this server
# cannot verify that it does. Default false.
MCP_ALLOW_GATED_WRITES=
# Print a stack trace if the server fails to start (default false)
MCP_DEBUG=
