  line_item      job_visit_line_item? @relation(fields: [line_item_id], references: [id])

  created_at     DateTime  @default(now())

  qb_time_activity_id String?
  account_id          String  @default("")

  @@index([visit_id])
  @@index([tech_id])
  @@index([visit_id, tech_id])
  @@index([clocked_out_at])
  @@unique([account_id, qb_time_activity_id])
}

model visit_tech_drive {
  id         String     @id @default(uuid())

  visit_id   String?
  visit      job_visit?  @relation(fields: [visit_id], references: [id], onDelete: Cascade)

