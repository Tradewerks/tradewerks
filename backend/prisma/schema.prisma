// ============================================================================
// USERS
// ============================================================================

model technician {
  id          String            @id @unique @default(uuid())
  organization_id String?
  organization    organization? @relation(fields: [organization_id], references: [id])
  name        String
  email       String            @unique
  phone       String
  password    String
  title       String
  description String
  status      technician_status @default(Offline)
  hire_date   DateTime
  coords      Json              @default("{}")
  last_ping_at DateTime?
  hourly_rate Decimal           @default(0) @db.Decimal(10, 2)
  last_login  DateTime?
  password_reset_token       String?   @unique
  password_reset_token_expires_at DateTime?
  theme       String            @default("system")

  organization_role_id String?
  organization_role    organization_role? @relation("TechnicianRole", fields: [organization_role_id], references: [id])

  current_vehicle_id String?
  current_vehicle    vehicle? @relation("CurrentVehicle", fields: [current_vehicle_id], references: [id])

  visit_techs    job_visit_technician[]
  time_entries   visit_tech_time_entry[]
  drives         visit_tech_drive[]
  notifications  technician_notification[]
  restock_records        vehicle_restock_record[]   @relation("TechnicianRestockRecords")
  stock_adjustments      vehicle_stock_adjustment[] @relation("TechnicianAdjustments")
  readiness_confirmations vehicle_readiness[]       @relation("TechReadinessConfirmations")
  performed_maintenance_records vehicle_maintenance_record[] @relation("TechPerformedMaintenance")

  created_client_notes      client_note[]  @relation("ClientNoteCreator")
  last_edited_client_notes  client_note[]  @relation("ClientNoteEditor")
  created_job_notes         job_note[]     @relation("JobNoteCreator")
  last_edited_job_notes     job_note[]     @relation("JobNoteEditor")
  created_request_notes     request_note[] @relation("RequestNoteCreator")
  last_edited_request_notes request_note[] @relation("RequestNoteEditor")
  created_quote_notes       quote_note[]   @relation("QuoteNoteCreator")
  last_edited_quote_notes   quote_note[]   @relation("QuoteNoteEditor")
  created_recurring_plan_notes      recurring_plan_note[] @relation("RecurringPlanNoteCreator")
  last_edited_recurring_plan_notes  recurring_plan_note[] @relation("RecurringPlanNoteEditor")

  recorded_invoice_payments    invoice_payment[]
  created_invoice_notes        invoice_note[]    @relation("InvoiceNoteCreator")
  last_edited_invoice_notes    invoice_note[]    @relation("InvoiceNoteEditor")

  created_project_notes     project_note[] @relation("ProjectNoteCreator")
  last_edited_project_notes project_note[] @relation("ProjectNoteEditor")

  shifts       technician_shift[]
  shift_breaks technician_shift_break[]
  provisional_items   inventory_item[] @relation("TechProvisionalItems")
  field_purchase_grants field_purchase_grant[]
  field_purchases       field_purchase[]
  external_mappings     technician_external_mapping[]
  timesheet_weeks       timesheet_week[]
  shift_corrections     shift_correction[]

  @@index([email])
  @@index([status])
  @@index([organization_id])
}

model technician_external_mapping {
  id            String @id @default(uuid())
  technician_id String
  provider      String
  account_id    String @default("")
  external_id   String

  technician technician @relation(fields: [technician_id], references: [id], onDelete: Cascade)

  // One QBO employee per technician and vice versa, per connected company file.
  @@unique([provider, account_id, external_id])
  @@unique([provider, technician_id, account_id])
  @@index([technician_id])
}

model dispatcher {
  id          String   @id @unique @default(uuid())
  organization_id String?
  role            DispatcherRole @default(dispatcher)
  organization    organization? @relation(fields: [organization_id], references: [id])
  name        String
  email       String   @unique
  phone       String?
  password    String
  title       String
  description String
  last_login  DateTime?
  email_verified_at         DateTime?
  email_verification_token  String?   @unique
  password_reset_token       String?   @unique
  password_reset_token_expires_at DateTime?
  theme       String   @default("system")
  muted_notification_types String[] @default([])
  dashboard_layout Json?
  report_layout    Json?
  kpi_layout       Json?

  organization_role_id String?
  organization_role    organization_role? @relation("DispatcherRole", fields: [organization_role_id], references: [id])

  created_requests        request[]        @relation("RequestCreator")
  created_quotes          quote[]          @relation("QuoteCreator")
  created_recurring_plans recurring_plan[] @relation("RecurringPlanCreator")
