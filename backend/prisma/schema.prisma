  created_job_notes         job_note[]     @relation("JobNoteCreator")
  last_edited_job_notes     job_note[]     @relation("JobNoteEditor")
  created_request_notes     request_note[] @relation("RequestNoteCreator")
  last_edited_request_notes request_note[] @relation("RequestNoteEditor")
  created_quote_notes       quote_note[]   @relation("QuoteNoteCreator")
  last_edited_quote_notes   quote_note[]   @relation("QuoteNoteEditor")

  created_recurring_plan_notes     recurring_plan_note[] @relation("RecurringPlanNoteCreator")
  last_edited_recurring_plan_notes recurring_plan_note[] @relation("RecurringPlanNoteEditor")

  created_project_notes     project_note[] @relation("ProjectNoteCreator")
  last_edited_project_notes project_note[] @relation("ProjectNoteEditor")

  recorded_invoice_payments    invoice_payment[]
  created_invoice_notes        invoice_note[]    @relation("InvoiceNoteCreator")
  last_edited_invoice_notes    invoice_note[]    @relation("InvoiceNoteEditor")

  restock_records vehicle_restock_record[] @relation("DispatcherRestockRecords")
  stock_adjustments vehicle_stock_adjustment[] @relation("DispatcherAdjustments")
  readiness_confirmations  vehicle_readiness[] @relation("DispatcherReadinessConfirmations")
  performed_maintenance_records vehicle_maintenance_record[] @relation("DispatcherPerformedMaintenance")
  approved_items      inventory_item[] @relation("DispatcherApprovedItems")
  acknowledged_restock_requests vehicle_restock_request[] @relation("DispatcherAcknowledgedRequests")

  managed_projects project[] @relation("ProjectManager")
  unmapped_part_decisions unmapped_part_decision[]
  granted_field_purchase_grants field_purchase_grant[] @relation("GrantedFieldPurchaseGrants")
  revoked_field_purchase_grants field_purchase_grant[] @relation("RevokedFieldPurchaseGrants")
  preauthorized_field_purchases field_purchase[]       @relation("PreauthorizedFieldPurchases")
  reviewed_field_purchases      field_purchase[]       @relation("ReviewedFieldPurchases")
  second_signed_field_purchases field_purchase[]       @relation("SecondSignedFieldPurchases")

  opened_disputes   document_dispute[] @relation("DisputeOpener")
  resolved_disputes document_dispute[] @relation("DisputeResolver")
  
  notifications      dispatcher_notification[]

  approved_timesheet_weeks timesheet_week[] @relation("TimesheetApprover")
  reviewed_shift_corrections shift_correction[]

  @@index([email])
  @@index([organization_id])
}

model vehicle_readiness {
  id              String       @id @default(uuid())
  vehicle_id      String
  vehicle         vehicle      @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  date            DateTime     @db.Date
  // Exactly one of confirmed_by_id or confirmed_by_tech_id is set (enforced by DB CHECK constraint)
  confirmed_by_id      String?
  confirmed_by         dispatcher?  @relation("DispatcherReadinessConfirmations", fields: [confirmed_by_id], references: [id])
  confirmed_by_tech_id String?
  confirmed_by_tech    technician?  @relation("TechReadinessConfirmations", fields: [confirmed_by_tech_id], references: [id])
  restock_record_id    String?              @unique
  restock_record       vehicle_restock_record? @relation("RestockReadiness", fields: [restock_record_id], references: [id])
  confirmed_at    DateTime     @default(now())
  notes           String?      @db.Text
  created_at      DateTime     @default(now())

  @@unique([vehicle_id, date])
  @@index([vehicle_id])
  @@index([organization_id])
  @@index([date])
}

// ============================================================================
// SHIFT TRACKING
// ============================================================================

enum shift_correction_status { 
  pending 
  accepted 
  rejected 
  superseded 
}

model shift_correction {
  id                 String                  @id @default(uuid())
  organization_id    String
  organization       organization            @relation(fields: [organization_id], references: [id])
  shift_id           String
  shift              technician_shift        @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  tech_id            String
  tech               technician              @relation(fields: [tech_id], references: [id])
  message            String
  proposed           Json                    // EditShiftInput shape: { started_at?, ended_at?, breaks?, entries? }
  status             shift_correction_status @default(pending)
  reviewed_by_id     String?
  reviewed_by        dispatcher?             @relation(fields: [reviewed_by_id], references: [id], onDelete: SetNull)
  reviewed_at        DateTime?
  review_note        String?
  created_at         DateTime                @default(now())

  @@index([shift_id, status])
  @@index([organization_id, status])
}

model technician_shift {
  id              String     @id @default(uuid())
  tech_id         String
  tech            technician @relation(fields: [tech_id], references: [id])
  org_id          String
  started_at      DateTime
  ended_at        DateTime?
  gross_hours     Decimal?   @db.Decimal(8, 4)
  break_hours     Decimal?   @db.Decimal(8, 4)
  payable_hours   Decimal?   @db.Decimal(8, 4)
  breaks          technician_shift_break[]
  corrections     shift_correction[]

  qb_time_activity_id String?
  account_id          String  @default("")

  @@index([tech_id])
  @@index([org_id])
  @@index([tech_id, ended_at])
  @@index([org_id, started_at])
  @@unique([account_id, qb_time_activity_id])
}

model technician_shift_break {
  id               String            @id @default(uuid())
  shift_id         String
  shift            technician_shift  @relation(fields: [shift_id], references: [id])
  tech_id          String
  tech             technician        @relation(fields: [tech_id], references: [id])
  reason           tech_break_reason
  is_paid          Boolean
  pre_break_status String
  started_at       DateTime
  ended_at         DateTime?
  duration_hrs     Decimal?          @db.Decimal(8, 4)

  @@index([shift_id])
  @@index([tech_id])
  @@index([tech_id, ended_at])
}

// ============================================================================
// LOGGING 
// ============================================================================

model log {
  id String @id @default(uuid())
  organization_id String?
  organization    organization? @relation(fields: [organization_id], references: [id])

  event_type  String // "client_note.created", "job.status_changed", "quote.sent"
  action      String // "created", "updated", "deleted", "viewed", "sent"
  entity_type String // "client_note", "job", "request", "quote", "client"
  entity_id   String // UUID of the entity

  actor_type String // "technician", "dispatcher", "system"
  actor_id   String?
  actor_name String?

  changes Json? // { field_name: { old: "...", new: "..." } }

  timestamp  DateTime @default(now())
  ip_address String?
  user_agent String?

  reason String?

  @@index([entity_type, entity_id])
  @@index([event_type])
  @@index([action])
  @@index([timestamp])
  @@index([actor_type, actor_id])
  @@index([actor_type])
  @@index([organization_id])
}

model external_sync_log {
  id              String   @id @default(uuid())
  provider        String
  entity_type     String   // "customer", "invoice"
  external_id     String
  action          String   // "upsert", "delete"
  payload         Json
  created_at      DateTime @default(now())
  organization_id String?

  @@index([organization_id, created_at])
  @@index([provider, external_id])
}

// ============================================================================
// INVOICING
// ============================================================================

model invoice_schedule {
  id                String                         @id @default(uuid())
  recurring_plan_id String                         @unique
  recurring_plan    recurring_plan                 @relation(fields: [recurring_plan_id], references: [id], onDelete: Cascade)
  frequency         invoice_schedule_frequency
  billing_basis     invoice_schedule_billing_basis
  fixed_amount      Decimal?                       @db.Decimal(10, 2)
  day_of_month      Int?
  day_of_week       weekday?
  generate_days_before Int                         @default(0)
  payment_terms_days   Int?
  auto_send         Boolean                        @default(false)
  memo_template     String?
  next_invoice_at   DateTime?
  last_invoiced_at  DateTime?
  is_active         Boolean                        @default(true)
  created_at        DateTime                       @default(now())
  updated_at        DateTime                       @updatedAt

  @@index([recurring_plan_id])
  @@index([is_active])
  @@index([is_active, next_invoice_at])
}

model invoice {
  id                       String         @id @default(uuid())
  organization_id          String?
  organization             organization?  @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  invoice_number           String
  client_id                String
  client                   client         @relation(fields: [client_id], references: [id], onDelete: Restrict)
  status                   invoice_status @default(Draft)
  recurring_plan_id        String?
  recurring_plan           recurring_plan? @relation(fields: [recurring_plan_id], references: [id], onDelete: SetNull)
  issue_date               DateTime?
  due_date                 DateTime?
  payment_terms_days       Int?
  issued_at                DateTime?
  sent_at                  DateTime?
  viewed_at                DateTime?
  paid_at                  DateTime?
  voided_at                DateTime?
  void_reason              String?
  subtotal                 Decimal        @default(0) @db.Decimal(10, 2)
  tax_rate                 Decimal        @default(0) @db.Decimal(5, 4)
  tax_amount               Decimal        @default(0) @db.Decimal(10, 2)
  discount_type            discount_type?
  discount_value           Decimal?       @db.Decimal(10, 2)
  discount_amount          Decimal?       @db.Decimal(10, 2)
  total                    Decimal        @default(0) @db.Decimal(10, 2)
  amount_paid              Decimal        @default(0) @db.Decimal(10, 2)
  balance_due              Decimal        @default(0) @db.Decimal(10, 2)
  memo                     String?
  internal_notes           String?
  tax_snapshot             Json?
  created_at               DateTime       @default(now())
  updated_at               DateTime       @updatedAt
  created_by_dispatcher_id String?
  created_by_dispatcher    dispatcher?    @relation(fields: [created_by_dispatcher_id], references: [id], onDelete: SetNull)
  qb_invoice_id            String?        // For QuickBooks integration — uniqueness via @@unique([account_id, qb_invoice_id])
  qb_sync_status           qb_sync_status @default(not_synced)
  account_id               String         @default("")

  version             Int      @default(1)
  previous_invoice_id String?  @unique
  previous_invoice    invoice? @relation("InvoiceRevisions", fields: [previous_invoice_id], references: [id])
  revised_invoice     invoice? @relation("InvoiceRevisions")

  // Non-null marks this row as an adjustment document. Deliberately NOT unique:
  // an invoice can accumulate several adjustments over its life.
  adjusts_invoice_id String?
  adjusts_invoice    invoice?  @relation("InvoiceAdjustments", fields: [adjusts_invoice_id], references: [id])
  adjustments        invoice[] @relation("InvoiceAdjustments")

  line_items invoice_line_item[]
  jobs       invoice_job[]
  visits     invoice_visit[]
  payments   invoice_payment[]
  notes      invoice_note[]
  disputes   document_dispute[] @relation("InvoiceDisputes")
  // Disputes that named this invoice as their replacement or their adjustment.
  replaced_for_disputes   document_dispute[] @relation("InvoiceDisputeReplacement")
  adjustment_for_disputes document_dispute[] @relation("InvoiceDisputeAdjustment")

  @@index([client_id])
  @@index([organization_id])
  @@index([status])
  @@index([invoice_number])
  @@index([issue_date])
  @@index([due_date])
  @@index([recurring_plan_id])
  @@index([client_id, status])
  @@index([organization_id, created_at])
  @@index([organization_id, issue_date])
  @@index([adjusts_invoice_id])
  @@unique([organization_id, invoice_number])
  @@unique([account_id, qb_invoice_id])
}

model invoice_line_item {
  id              String         @id @default(uuid())
  invoice_id      String
  invoice         invoice        @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  source_job_id   String?
  source_visit_id String?
  name            String
  description     String?
  quantity        Decimal        @db.Decimal(10, 2)
  unit_price      Decimal        @db.Decimal(10, 2)
  total           Decimal        @db.Decimal(10, 2)
  item_type       line_item_type?
  sort_order      Int            @default(0)
  tax_group_id    String?
  tax_group       tax_group? @relation(fields: [tax_group_id], references: [id], onDelete: SetNull)
  taxable         Boolean    @default(true)
  tax_amount      Decimal?   @db.Decimal(10, 2)
  inventory_item_id String?
  inventory_item  inventory_item? @relation(fields: [inventory_item_id], references: [id], onDelete: SetNull)
  
  @@index([inventory_item_id])
  @@index([invoice_id])
  @@index([sort_order])
}

model invoice_job {
  invoice_id    String
  invoice       invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  job_id        String
  job           job      @relation(fields: [job_id], references: [id], onDelete: Restrict)
  billed_amount Decimal? @db.Decimal(10, 2)

  @@id([invoice_id, job_id])
  @@index([job_id])
  @@index([invoice_id])
}

model invoice_visit {
  invoice_id    String
  invoice       invoice   @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  visit_id      String
  visit         job_visit @relation(fields: [visit_id], references: [id], onDelete: Restrict)
  billed_amount Decimal   @db.Decimal(10, 2)

  @@id([invoice_id, visit_id])
  @@index([visit_id])
  @@index([invoice_id])
}

model invoice_payment {
  id                        String      @id @default(uuid())
  invoice_id                String
  invoice                   invoice     @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  amount                    Decimal     @db.Decimal(10, 2)
  paid_at                   DateTime    @default(now())
  method                    String?
  note                      String?
  recorded_by_dispatcher_id String?
  recorded_by_dispatcher    dispatcher? @relation(fields: [recorded_by_dispatcher_id], references: [id], onDelete: SetNull)
  recorded_by_tech_id       String?
  recorded_by_tech          technician? @relation(fields: [recorded_by_tech_id], references: [id], onDelete: SetNull)
  created_at                DateTime    @default(now())
  qb_payment_id             String?     // uniqueness via @@unique([account_id, qb_payment_id])
  account_id                String      @default("")

  @@index([invoice_id])
  @@index([paid_at])
  @@index([recorded_by_tech_id])
  @@unique([account_id, qb_payment_id])
}

model invoice_note {
  id                        String        @id @default(uuid())
  organization_id           String?
  organization              organization? @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  invoice_id                String
  invoice                   invoice       @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  content                   String
  created_at                DateTime      @default(now())
  updated_at                DateTime      @updatedAt
  creator_tech_id           String?
  creator_tech              technician?   @relation("InvoiceNoteCreator", fields: [creator_tech_id], references: [id], onDelete: SetNull)
  creator_dispatcher_id     String?
  creator_dispatcher        dispatcher?   @relation("InvoiceNoteCreator", fields: [creator_dispatcher_id], references: [id], onDelete: SetNull)
  last_editor_tech_id       String?
  last_editor_tech          technician?   @relation("InvoiceNoteEditor", fields: [last_editor_tech_id], references: [id], onDelete: SetNull)
  last_editor_dispatcher_id String?
  last_editor_dispatcher    dispatcher?   @relation("InvoiceNoteEditor", fields: [last_editor_dispatcher_id], references: [id], onDelete: SetNull)

  @@index([invoice_id])
}

// ============================================================================
// AUTOMATED FOLLOWUPS
// ============================================================================

model followup_sequence {
  id              String        @id @default(uuid())
  organization_id String?
  organization    organization? @relation(fields: [organization_id], references: [id])
  name            String
  description     String?
  trigger_type    followup_trigger_type @default(manual)
  trigger_config  Json?
  stop_on_open    Boolean       @default(true)
  is_active       Boolean       @default(true)
  created_by_dispatcher_id String?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  steps       followup_step[]
  enrollments followup_enrollment[]

  @@index([trigger_type])
  @@index([organization_id, trigger_type, is_active])
}

model followup_step {
  id                String   @id @default(uuid())
  sequence_id       String
  sequence          followup_sequence @relation(fields: [sequence_id], references: [id], onDelete: Cascade)
  step_order        Int
  // The category IS the Postmark template alias sent for this step; org branding
  // (logo, accent) is passed as template-model variables at send time.
  category          email_template_category @default(followup)
  delay_amount      Int      @default(0)
  delay_unit        String   @default("days") // "hours" | "days"
  condition         followup_step_condition @default(if_previous_not_opened)
  created_at        DateTime @default(now())

  sends followup_send[]

  @@unique([sequence_id, step_order])
  @@index([sequence_id])
}

model followup_enrollment {
  id                 String   @id @default(uuid())
  organization_id    String?
  organization       organization? @relation(fields: [organization_id], references: [id])
  sequence_id        String
  sequence           followup_sequence @relation(fields: [sequence_id], references: [id], onDelete: Cascade)
  client_id          String
  client             client   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  contact_id         String?
  recipient_email    String
  status             followup_enrollment_status @default(active)
  current_step_order Int      @default(0)
  next_send_at       DateTime?
  anchor_entity_type String?  // "quote" | "invoice" | "request" | "job_visit"
  anchor_entity_id   String?
  anchor_at          DateTime? // anchor datetime: visit start (reminders) or target date (date_based)
  enrolled_by_dispatcher_id String? // null = system/auto
  started_at         DateTime @default(now())
  completed_at       DateTime?
  stopped_at         DateTime?
  stop_reason        String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  sends followup_send[]

  @@index([organization_id])
  @@index([status, next_send_at])
  @@index([anchor_entity_type, anchor_entity_id])
  @@index([sequence_id])
  @@index([client_id])
}

model followup_send {
  id                  String   @id @default(uuid())
  organization_id     String?
  organization        organization? @relation(fields: [organization_id], references: [id])
  enrollment_id       String
  enrollment          followup_enrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  step_id             String?
  step                followup_step? @relation(fields: [step_id], references: [id], onDelete: SetNull)
  template_alias      String?  // the Postmark alias (step category) actually sent
  recipient_email     String
  postmark_message_id String?  @unique
  status              followup_send_status @default(sent)
  sent_at             DateTime @default(now())
  opened_at           DateTime?
  open_count          Int      @default(0)
  error               String?
  created_at          DateTime @default(now())

  @@index([enrollment_id])
  @@index([organization_id])
  @@index([step_id])
}

// One editable email template per org+category. The category matches a followup
// step's category; at send time we render this template's subject/html with the
// org branding + client variables and send it via Postmark HtmlBody (no hosted
// Postmark template). A missing row falls back to a built-in default in code
// (services/followupTemplateDefaults.ts).
model email_template {
  id                       String   @id @default(uuid())
  organization_id          String
  organization             organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  category                 email_template_category
  name                     String
  subject                  String
  html                     String   @db.Text
  // Editable plain-text alternative (text/plain MIME part). NULL = auto-generate
  // from the HTML at send time.
  text                     String?  @db.Text
  updated_by_dispatcher_id String?
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  @@unique([organization_id, category])
  @@index([organization_id])
}

// ============================================================================
// Verification tokens
// ============================================================================

model otp_verification {
  id        String   @id @default(cuid())
  userId    String
  role      String   // 'dispatcher' | 'technician'
  otp       String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, role])
}

model jwt_refresh_token {
  id        String   @id @default(cuid())
  userId    String
  role      String   // 'dispatcher' | 'technician'
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, role])
}

model mfa_credential {
  id              String   @id @default(cuid())
  user_id         String
  role            String   
  secret          String   // AES-256-GCM encrypted base32 TOTP secret
  enabled         Boolean  @default(false) 
  enrolled_at     DateTime?
  failed_attempts Int @default(0)
  locked_until    DateTime?
  created_at      DateTime @default(now())

  @@unique([user_id, role])
}

model mfa_recovery_code {
  id         String   @id @default(cuid())
  user_id    String
  role       String  
  code       String   // sha256 of a single-use recovery code
  used_at    DateTime?
  created_at DateTime @default(now())

  @@index([user_id, role])
}

// ============================================================================
// SSO
// ============================================================================

model sso_handoff {
  id          String @id @default(uuid())
  code_hash   String @unique
  user_id     String
  role        String
  expires_at  DateTime 
  created_at  DateTime  @default(now())
}

// ============================================================================
// TAX SYSTEM
// ============================================================================

model tax_rate {
	id              String       @id @default(uuid())
	organization_id String
	organization    organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
	name            String
	rate            Decimal      @db.Decimal(5, 4) // 0.0000 to 1.0000 — consistent with existing schema
	description     String?
	jurisdiction    String?      // free label: "State", "County", "City", "Federal"
	is_default      Boolean      @default(false)
	is_active       Boolean      @default(true)
	created_at      DateTime     @default(now())
	updated_at      DateTime     @updatedAt

	group_rates     tax_group_rate[]

	@@unique([organization_id, name])
	@@index([organization_id])
	@@index([organization_id, is_default])
	@@index([organization_id, is_active])
}

model tax_group {
	id              String       @id @default(uuid())
	organization_id String
	organization    organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
	name            String
	description     String?
	is_default      Boolean      @default(false)
	is_active       Boolean      @default(true)
	created_at      DateTime     @default(now())
	updated_at      DateTime     @updatedAt
  qb_tax_code_id  String?

	rates                     tax_group_rate[]
	invoice_line_items        invoice_line_item[]
	quote_line_items          quote_line_item[]
	job_line_items            job_line_item[]
	job_visit_line_items      job_visit_line_item[]
	recurring_plan_line_items recurring_plan_line_item[]
	clients                   client[]
	purchases                 purchase[]

	@@unique([organization_id, name])
	@@index([organization_id])
	@@index([organization_id, is_default])
	@@index([organization_id, is_active])
}

model tax_group_rate {
	id           String    @id @default(uuid())
	tax_group_id String
	tax_group    tax_group @relation(fields: [tax_group_id], references: [id], onDelete: Cascade)
	tax_rate_id  String
	tax_rate     tax_rate  @relation(fields: [tax_rate_id], references: [id], onDelete: Restrict)
	sort_order   Int       @default(0)

	@@unique([tax_group_id, tax_rate_id])
	@@index([tax_group_id])
}


// ============================================================================
// OAuth
// ============================================================================

model oauth_client {
	id              String   @id @default(uuid())
	client_id       String   @unique
	client_secret   String   // hash 
	name            String   
	redirect_uris   String[] 
	is_confidential Boolean  @default(true)
	created_at      DateTime @default(now())

	auth_codes     oauth_auth_code[]
	refresh_tokens oauth_refresh_token[]
}

model oauth_auth_code {
	id                    String       @id @default(uuid())
	code_hash             String       @unique 
	client_id             String
	client                oauth_client @relation(fields: [client_id], references: [client_id], onDelete: Cascade)
	user_id               String       
	role                  String       
	organization_id       String?
	redirect_uri          String       
	scope                 String?
	code_challenge        String?      
	code_challenge_method String?
	expires_at            DateTime     
	consumed_at           DateTime?      
	created_at            DateTime     @default(now())

	@@index([client_id])
	@@index([expires_at])
}

model oauth_refresh_token {
	id              String       @id @default(uuid())
	token_hash      String       @unique 
	client_id       String
	client          oauth_client @relation(fields: [client_id], references: [client_id], onDelete: Cascade)
	user_id         String
	role            String
	organization_id String?
	scope           String?
	expires_at      DateTime     
	revoked_at      DateTime?
	replaced_by     String?     
	created_at      DateTime     @default(now())

	@@index([user_id, role])
	@@index([client_id])
}

// ============================================================================
// AI ASSISTANT
// ============================================================================

/// One chat thread between a person and the assistant.
///
/// `user_id` carries no foreign key on purpose: dispatchers and technicians live
/// in separate tables, so a single column cannot reference both. `user_role`
/// records which table it points at.
model assistant_conversation {
  id              String       @id @default(uuid())
  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  user_id   String
  user_role String // dispatcher | technician | admin

  title       String? // generated from the first exchange
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime?

  messages assistant_message[]

  @@index([organization_id, user_id, updated_at])
  @@index([organization_id, updated_at])
}

/// One turn in a conversation. Assistant turns carry the token counts the turn
/// cost, so the pricing question has data behind it before it has to be answered.
model assistant_message {
  id              String                 @id @default(uuid())
  conversation_id String
  conversation    assistant_conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  role    String // user | assistant
  content String @db.Text

  model         String?
  finish_reason String?
  input_tokens  Int?
  output_tokens Int?

  created_at DateTime @default(now())

  tool_calls assistant_tool_call[]

  @@index([conversation_id, created_at])
}

/// One tool invocation made while producing an assistant turn.
///
/// `provider_call_id` is the id the model provider assigned. It is stored because
/// replaying a transcript on the next turn requires pairing each result back to
/// the call that asked for it — without it the history cannot be reconstructed.
model assistant_tool_call {
  id         String            @id @default(uuid())
  message_id String
  message    assistant_message @relation(fields: [message_id], references: [id], onDelete: Cascade)

  provider_call_id String
  tool_name        String
  input            Json
  status           String // ok | error | pending_approval | approved | rejected
  result           Json?
  error_code       String?
  duration_ms      Int?

  // Set when a human approved a gated call (Phase 3). Null for reads.
  approved_by  String?
  created_at   DateTime  @default(now())
  completed_at DateTime?

  @@index([message_id])
  @@index([tool_name])
}

model timesheet_week {
  id                        String         @id @default(uuid())
  organization_id           String
  organization              organization   @relation(fields: [organization_id], references: [id])
  technician_id             String
  technician                technician     @relation(fields: [technician_id], references: [id])

  week_start                DateTime       @db.Date // Monday in the org's timezone
  approved_at               DateTime?
  approved_by_dispatcher_id String?
  approved_by_dispatcher    dispatcher?    @relation("TimesheetApprover", fields: [approved_by_dispatcher_id], references: [id], onDelete: SetNull)

  qb_sync_status            qb_sync_status @default(not_synced)
  qb_synced_at              DateTime?
  qb_error                  String?

  @@unique([technician_id, week_start])
  @@index([organization_id, week_start])
}
