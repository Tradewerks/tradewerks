// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

enum job_status {
  Unscheduled
  Scheduled
  InProgress
  Completed
  Cancelled
}

enum arrival_constraint {
  anytime
  at
  between
  by
}

enum finish_constraint {
  when_done
  at
  by
}

enum discount_type {
  percent
  amount
}

enum line_item_type {
  labor
  material
  equipment
  other
}

enum line_item_source {
  quote
  recurring_plan
  manual          //dispatch
  field_addition  //tech
}

enum vehicle_adjustment_type {
  warehouse_exchange
  field_loss
  transfer
  audit
  supplier_purchase
}

enum stock_location_type {
  warehouse
  vehicle
  consumed   // parts used on a visit (virtual sink)
  adjustment // loss / audit corrections (virtual sink/source)
  external   // receiving / initial backfill (virtual source)
}

enum stock_movement_reason {
  receive
  restock
  return_to_warehouse
  parts_used
  direct_consumption
  loss
  audit_correction
  transfer
  reversal
  initial
  supplier_purchase
}

enum serial_unit_status {
  in_warehouse
  on_vehicle
  consumed
  lost
  returned
}

enum restock_mode {
  tech_self_serve
  dispatch_prepared
}

enum restock_record_mode {
  restock
  prepare
}

enum line_item_fulfillment {
  planned // dispatch-attached, not yet reconciled
  used    // consumed (stock movement written)
  voided  // tech marked not used: billing zeroed, qty_planned kept for variance
}

// fulfillment_status above is lifecycle; this is what settling the line does.
enum line_item_disposition {
  consume   // deduct from stock at completion (pre-existing behaviour)
  receive   // quantity LANDS in stock at cost, at disposition_location
  non_stock // billed, never in our inventory (vendor direct) - no stock effect
}

// Backfilled from created_by_tech_id, so historical rows are approximate.
enum inventory_item_origin {
  tech_submission    // tech supplied new_item {name, cost} on a supplier purchase
  dispatch_quick_add // created by dispatch: line-item quick-add or the New Item form
  field_purchase     // emergency field procurement (receipt capture)
  import             // spreadsheet import or a QuickBooks item pull
}

// Under-limit purchases skip pending_preauth entirely: draft -> pending_review.
enum field_purchase_status {
  draft
  pending_preauth
  preauth_denied
  preauth_approved
  pending_review
  queried // returned to the tech with a note; editable again
  pending_second_signoff // over the org threshold: approved once, waiting on a second
  approved
  rejected
}

// A refund is the same shape as the purchase it reverses - same receipt, lines,
// review and trail - so it is a kind of field_purchase rather than a model of
// its own. Amounts stay positive; this column is what says which way they point.
enum field_purchase_kind {
  purchase
  refund
}

// `skipped` is a success, not a failure: no provider is configured, so the
// technician types the receipt in by hand (the spec's required fallback).
enum field_purchase_ocr_status {
  not_run
  skipped
  pending
  succeeded
  failed
}

enum visit_status {
  Scheduled
  Driving
  OnSite
  InProgress
  Paused
  Delayed
  Completed
  Cancelled
}

enum request_status {
  New
  Reviewing
  Quoted
  QuoteApproved
  QuoteRejected
  ConvertedToJob
  Cancelled
}

enum document_kind {
  quote
  invoice
}

enum dispute_status {
  Open
  Resolved
}

enum dispute_resolution {
  ReviseAndResend
  IssueAdjustment
  Repeal
}

enum quote_status {
  Draft
  Issued
  Sent
  Viewed
  Approved
  Disputed
  Rejected
  Revised
  Expired
  Cancelled
}

enum priority {
  Low
  Medium
  High
  Urgent
  Emergency
}

enum technician_status {
  Offline
  Available
  Break
  EnRoute
  OnSite
  Working
  Paused
  WrappingUp
  HeadingBack
}

enum tech_visit_status {
  Assigned
  EnRoute
  OnSite
  Done
}

enum pause_reason_type {
  AwaitingMaterials
  EquipmentIssue
  Break
  Other
}

enum tech_break_reason {
  Lunch
  Rest
  EquipmentIssue
  Other
}

enum recurring_plan_status {
  Active
  Paused
  Completed
  Cancelled
}

enum billing_mode {
  per_visit      
  subscription   
  none          
}

enum invoice_timing {
  on_completion      // Generate invoice when visit completed
  on_schedule_date   // Generate invoice on scheduled date
  manual             // Never auto-generate
}

enum occurrence_status {
  planned 
  generated 
  skipped     
  cancelled   
  completed   
}

enum recurring_frequency {
  daily
  weekly
  monthly
  yearly
}

enum weekday {
  MO
  TU
  WE
  TH
  FR
  SA
  SU
}

enum form_draft_type {
  request
  quote
  job
  job_visit
  recurring_plan
  invoice
}

// Stored values are frozen; the UI labels two of them differently. Issued
// displays as "Created" and Paid as "Fully Paid" (pairing with "Partially
// Paid"). The display strings live in frontend/src/types/invoices.ts
// (InvoiceStatusLabels) and are mirrored by the invoice PDF template and the
// dispute adapter. Quote statuses are unaffected: a quote's Issued still
// reads "Issued".
enum invoice_status {
  Draft
  Issued
  Sent
  Viewed
  PartiallyPaid
  Paid
  Disputed
  Void
}

enum invoice_schedule_frequency {
  weekly
  biweekly
  monthly
  quarterly
  on_visit_completion
}

enum invoice_schedule_billing_basis {
  fixed_amount
  visit_actuals
  plan_line_items
  invoice
}

/* Add more roles here if needed */
enum DispatcherRole {
  dispatcher
  admin
}

/* QuickBooks sync status for invoices */
enum qb_sync_status {
  not_synced
  synced
  failed
}

enum followup_trigger_type {
  manual
  date_based
  quote_sent
  invoice_sent
  request_created
  visit_scheduled
}

enum followup_step_condition {
  always
  if_previous_not_opened
}

enum followup_enrollment_status {
  active
  completed
  stopped
  failed
}

enum followup_send_status {
  sent
  skipped
  failed
}

enum email_template_category {
  followup
  reminder
  quote_chase
  invoice_chase
  request_ack
  custom
}

enum project_status {
  Planning
  Active
  OnHold
  Completed
  Cancelled
}

model organization {
  id        String  @id @default(uuid())
  name      String
  timezone  String  @default("America/Chicago") // IANA timezone identifier
  logo_url  String?
  phone     String?
  address   String?
  coords    Json?
  email     String?
  website   String?
  tax_rate            Decimal @default(0) @db.Decimal(5, 4)
  wrapping_up_minutes Int     @default(15)
  restock_mode        restock_mode @default(tech_self_serve)
  // "imperial" | "metric". ORDERS the unit picker for the org's region and drives
  // the form default — it hides nothing (a US org still reaches `mm`) and converts
  // nothing. String + app-level Zod enum, same reasoning as inventory_item.unit.
  // NOT a general locale: currency and number formatting are still en-US/USD
  // throughout the frontend, which is a separate project.
  measurement_system  String       @default("imperial")
  // Above this, an approved field purchase waits for a second, different
  // signer before anything moves. Null disables the second sign-off entirely.
  field_purchase_second_signoff_threshold Decimal? @db.Decimal(10, 2)
  mfa_required        Boolean @default(false) // Require MFA for all users in this org

  logo_key String?

  brand_color       String?  @default("#1e3a5f")
  followups_enabled Boolean  @default(false)

  // quickbooks integration fields
  qb_realm_id           String?
  qb_access_token       String?
  qb_refresh_token      String?
  qb_token_expires_at   DateTime? 
  
  clients               client[]
  contacts              contact[]
  technicians           technician[]
  dispatchers           dispatcher[]
  inventory_items       inventory_item[]
  inventory_tags        inventory_tag[]
  vehicles              vehicle[]
  logs                  log[]
  vehicle_readiness     vehicle_readiness[]
  vehicle_maintenance_records vehicle_maintenance_record[]
  vehicle_maintenance_reminders vehicle_maintenance_reminder[]
  stock_movements       stock_movement[]
  serial_units          serial_unit[]
  stock_batches         stock_batch[]
  suppliers             supplier[]
  supplier_items        supplier_item[]
  unmapped_part_decisions unmapped_part_decision[]
  field_purchase_grants   field_purchase_grant[]
  field_purchases         field_purchase[]
  field_purchase_events   field_purchase_event[]
  purchases               purchase[]
  purchase_events         purchase_event[]

  requests              request[]
  quotes                quote[]
  jobs                  job[]
  recurring_plans       recurring_plan[]
  projects              project[]
  form_drafts           form_draft[]
  invoices              invoice[]

  client_notes          client_note[]
  request_notes         request_note[]
  quote_notes           quote_note[]
  job_notes             job_note[]
  recurring_plan_notes  recurring_plan_note[]
  invoice_notes         invoice_note[]
  project_notes         project_note[]

  tax_rates             tax_rate[]
  tax_groups            tax_group[]
  organization_roles    organization_role[]             

  saved_reports         saved_report[]
  report_favorites      report_favorite[]

  followup_sequences   followup_sequence[]
  followup_enrollments followup_enrollment[]
  followup_sends       followup_send[]
  email_templates      email_template[]

  assistant_conversations assistant_conversation[]
  document_disputes document_dispute[]
  timesheet_weeks   timesheet_week[]
  shift_corrections shift_correction[]
}

model saved_report {
  id              String   @id @default(uuid())
  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id])
  name            String
  description     String?
  source          String
  config          Json
  created_by_id   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([organization_id, name])
  @@index([organization_id])
  @@index([created_by_id])
}

model report_favorite {
  id              String   @id @default(uuid())
  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id])
  dispatcher_id   String
  kind            String
  ref             String
  created_at      DateTime @default(now())

  @@unique([dispatcher_id, kind, ref])
  @@index([dispatcher_id])
  @@index([organization_id])
}

model organization_role {
  id              String        @id @default(uuid())
  organization_id String?
  organization    organization? @relation(fields: [organization_id], references: [id])
  name            String
  base_tier       String        // "dispatcher" | "technician"
  permissions     String[]
  is_default      Boolean       @default(false)

  technicians  technician[]  @relation("TechnicianRole")
  dispatchers  dispatcher[]  @relation("DispatcherRole")

  @@index([organization_id])
}

// ============================================================================
// Contact
// ============================================================================

model contact {
  id        String  @id @unique @default(uuid())
  organization_id String?
  organization    organization? @relation(fields: [organization_id], references: [id])
  name      String
  email     String?
  phone     String?
  type      String? // "customer", "vendor", "property_manager", "tenant"
  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  client_contacts client_contact[]

  @@unique([organization_id, email])
  @@unique([organization_id, phone])

  @@index([email])
  @@index([phone])
  @@index([is_active])
  @@index([organization_id])
}

model client_contact {
  client_id  String
  contact_id String
  client     client  @relation(fields: [client_id], references: [id], onDelete: Cascade)
  contact    contact @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  relationship String  @default("contact")
  is_primary   Boolean @default(false)
  is_billing   Boolean @default(false)

  @@id([client_id, contact_id])
  @@index([contact_id])
}

// ============================================================================
// Client
// ============================================================================

model client {
  id              String   @id @unique @default(uuid())
  organization_id String?
  organization    organization? @relation(fields: [organization_id], references: [id])
  name            String
  address         String
  coords          Json
  is_active       Boolean  @default(true)
  is_tax_exempt   Boolean  @default(false)
  tax_rate        Decimal? @db.Decimal(5, 4)
  tax_group_id    String?
  tax_group       tax_group? @relation(fields: [tax_group_id], references: [id], onDelete: SetNull)
  created_at      DateTime @default(now())
  last_activity   DateTime @default(now())
  updated_at      DateTime @updatedAt

  contacts        client_contact[]
  requests        request[]
  quotes          quote[]
  jobs            job[]
  notes           client_note[]
  recurring_plans recurring_plan[]
  invoices        invoice[]
  client_external_mapping client_external_mapping[]
  serial_units    serial_unit[]
  followup_enrollments followup_enrollment[]
  projects        project[]

  @@index([is_active])
  @@index([is_tax_exempt])
  @@index([created_at])
  @@index([organization_id])
}

model client_external_mapping {
  id          String @id @default(uuid())

  client_id   String 
  provider    String
  account_id  String @default("")
  external_id String

  client      client @relation(fields: [client_id], references: [id])

  @@unique([provider, account_id, external_id])
  @@unique([provider, client_id, account_id])
  @@index([client_id])
}

model client_note {
  id        String @id @unique @default(uuid())
  organization_id String?
  organization    organization? @relation(fields: [organization_id], references: [id])
  client_id String
  client    client @relation(fields: [client_id], references: [id], onDelete: Cascade)

  content    String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  creator_tech_id           String?
  creator_dispatcher_id     String?
  last_editor_tech_id       String?
  last_editor_dispatcher_id String?

  creator_tech           technician? @relation("ClientNoteCreator", fields: [creator_tech_id], references: [id])
  creator_dispatcher     dispatcher? @relation("ClientNoteCreator", fields: [creator_dispatcher_id], references: [id])
  last_editor_tech       technician? @relation("ClientNoteEditor", fields: [last_editor_tech_id], references: [id])
  last_editor_dispatcher dispatcher? @relation("ClientNoteEditor", fields: [last_editor_dispatcher_id], references: [id])

  @@index([client_id])
  @@index([created_at])
}

// ============================================================================
// REQUEST → QUOTE → JOB 
// ============================================================================

model request {
  id        String @id @default(uuid())
  organization_id String?
  organization    organization? @relation(fields: [organization_id], references: [id])
  client_id String
  client    client @relation(fields: [client_id], references: [id])

  title       String
  description String         @db.Text
  priority    priority       @default(Medium)
  address     String?
  coords      Json?
  status      request_status @default(New)
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  requires_quote   Boolean  @default(false)
  estimated_value  Decimal? @db.Decimal(10, 2)
  source           String? // "phone", "email", "web"
  source_reference String?

  cancelled_at        DateTime?
  cancellation_reason String?

  quotes       quote[]
  jobs         job[]
  notes        request_note[]
  created_by_dispatcher_id String?
  created_by_dispatcher   dispatcher?    @relation("RequestCreator", fields: [created_by_dispatcher_id], references: [id])
 

  @@index([client_id])
  @@index([status])
  @@index([priority])
  @@index([created_at])
  @@index([updated_at])
  @@index([created_by_dispatcher_id])
  @@index([status, priority]) // Composite for "urgent pending requests"
  @@index([organization_id, created_at])
}

model request_note {
  id         String  @id @default(uuid())
  organization_id String?
  organization    organization? @relation(fields: [organization_id], references: [id])
  request_id String
  request    request @relation(fields: [request_id], references: [id], onDelete: Cascade)

  content    String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  creator_tech_id           String?
  creator_dispatcher_id     String?
  last_editor_tech_id       String?
  last_editor_dispatcher_id String?

  creator_tech           technician? @relation("RequestNoteCreator", fields: [creator_tech_id], references: [id])
  creator_dispatcher     dispatcher? @relation("RequestNoteCreator", fields: [creator_dispatcher_id], references: [id])
  last_editor_tech       technician? @relation("RequestNoteEditor", fields: [last_editor_tech_id], references: [id])
  last_editor_dispatcher dispatcher? @relation("RequestNoteEditor", fields: [last_editor_dispatcher_id], references: [id])

  @@index([request_id])
}

model quote {
  id           String   @id @default(uuid())
  organization_id String?
  organization    organization? @relation(fields: [organization_id], references: [id])
  quote_number String
  client_id    String
  client       client   @relation(fields: [client_id], references: [id])
  request_id   String?
  request      request? @relation(fields: [request_id], references: [id])

  title       String
  description String       @db.Text
  status      quote_status @default(Draft)

  address  String
  coords   Json?
  priority priority @default(Medium)

  is_active         Boolean @default(true)
  version           Int     @default(1)
  previous_quote_id String? @unique
  previous_quote    quote?  @relation("QuoteRevisions", fields: [previous_quote_id], references: [id])
  revised_quote     quote?  @relation("QuoteRevisions")

  subtotal            Decimal @db.Decimal(10, 2)
  tax_rate            Decimal @default(0) @db.Decimal(5, 4)
  tax_amount          Decimal @default(0) @db.Decimal(10, 2)
  discount_type        discount_type?
  discount_value       Decimal?  @db.Decimal(10, 2)  // User input value
  discount_amount      Decimal?  @db.Decimal(10, 2)  // Calculated discount $
  total               Decimal @db.Decimal(10, 2)

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  issued_at   DateTime?
  sent_at     DateTime?
  viewed_at   DateTime?
  approved_at DateTime?
  rejected_at DateTime?

  valid_until DateTime? //The pricing deadline for the client to accept the quote (revision needed)
  expires_at  DateTime? //The deadline for when the quote is invalid/expired

  rejection_reason String?

  tax_snapshot Json?

  created_by_dispatcher_id String?
  created_by_dispatcher    dispatcher? @relation("QuoteCreator", fields: [created_by_dispatcher_id], references: [id])

  line_items quote_line_item[]
  notes      quote_note[]
  job        job?
  disputes   document_dispute[] @relation("QuoteDisputes")
  // Disputes that named this quote as their Revise & Resend replacement.
  replaced_for_disputes document_dispute[] @relation("QuoteDisputeReplacement")

  @@index([client_id])
  @@index([request_id])
  @@index([status])
  @@index([is_active])
  @@index([quote_number])
  @@index([created_at])
  @@index([client_id, is_active])
  @@index([request_id, is_active])
  @@index([organization_id, created_at])
  @@unique([organization_id, quote_number])
}

// The real enforcement disputesController.ts calls out isn't visible here:
// the partial unique indexes `dispute_one_open_per_quote` /
// `dispute_one_open_per_invoice` (one Open dispute per document) and two
// CHECK constraints live only in migration SQL
// (20260904210133_document_dispute), not in this model. See U1.
model document_dispute {
  id              String        @id @default(uuid())
  organization_id String?
  organization    organization? @relation(fields: [organization_id], references: [id])

  document_kind document_kind
  quote_id      String?
  quote         quote?   @relation("QuoteDisputes", fields: [quote_id], references: [id], onDelete: Cascade)
  invoice_id    String?
  invoice       invoice? @relation("InvoiceDisputes", fields: [invoice_id], references: [id], onDelete: Cascade)

  status                  dispute_status @default(Open)
  reason                  String         @db.Text
  contested_line_item_ids Json?
  status_at_open          String

  opened_by_dispatcher_id String?
  opened_by_dispatcher    dispatcher? @relation("DisputeOpener", fields: [opened_by_dispatcher_id], references: [id], onDelete: SetNull)
  opened_at               DateTime    @default(now())

  resolution                dispute_resolution?
  resolution_note           String?             @db.Text
  resolved_by_dispatcher_id String?
  resolved_by_dispatcher    dispatcher?         @relation("DisputeResolver", fields: [resolved_by_dispatcher_id], references: [id], onDelete: SetNull)
  resolved_at               DateTime?

  // Real relations, not bare ids: without a constraint these silently become
  // dangling pointers the moment the document they name is deleted. Restrict
  // rather than SetNull because the document a resolution produced is part of
  // the audit trail — nulling the link would erase what the resolution did.
  replacement_quote_id   String?
  replacement_quote      quote?   @relation("QuoteDisputeReplacement", fields: [replacement_quote_id], references: [id], onDelete: Restrict)
  replacement_invoice_id String?
  replacement_invoice    invoice? @relation("InvoiceDisputeReplacement", fields: [replacement_invoice_id], references: [id], onDelete: Restrict)
  adjustment_invoice_id  String?
  adjustment_invoice     invoice? @relation("InvoiceDisputeAdjustment", fields: [adjustment_invoice_id], references: [id], onDelete: Restrict)

  @@index([organization_id, status])
  @@index([quote_id])
  @@index([invoice_id])
  @@index([replacement_quote_id])
  @@index([replacement_invoice_id])
  @@index([adjustment_invoice_id])
  // Both carry SetNull FKs, so deleting a dispatcher had to seq-scan this
  // table to null them out.
  @@index([opened_by_dispatcher_id])
  @@index([resolved_by_dispatcher_id])
}

model quote_line_item {
  id       String @id @default(uuid())
  quote_id String
  quote    quote  @relation(fields: [quote_id], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  quantity    Decimal @db.Decimal(10, 2)
  unit_price  Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  item_type    line_item_type?
  sort_order   Int     @default(0)
  tax_group_id String?
  tax_group    tax_group? @relation(fields: [tax_group_id], references: [id], onDelete: SetNull)
  taxable      Boolean    @default(true)
  tax_amount   Decimal?   @db.Decimal(10, 2)

  // Reference only; carried so the link survives quote -> job -> visit.
  inventory_item_id String?
  inventory_item    inventory_item? @relation("QuoteLineItemInventory", fields: [inventory_item_id], references: [id], onDelete: SetNull)

  @@index([quote_id])
  @@index([sort_order])
  @@index([inventory_item_id])
}

model quote_note {
  id       String @id @default(uuid())
  organization_id String?
  organization    organization? @relation(fields: [organization_id], references: [id])
  quote_id String
  quote    quote  @relation(fields: [quote_id], references: [id], onDelete: Cascade)

  content    String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  creator_tech_id           String?
  creator_dispatcher_id     String?
  last_editor_tech_id       String?
  last_editor_dispatcher_id String?

  creator_tech           technician? @relation("QuoteNoteCreator", fields: [creator_tech_id], references: [id])
  creator_dispatcher     dispatcher? @relation("QuoteNoteCreator", fields: [creator_dispatcher_id], references: [id])
  last_editor_tech       technician? @relation("QuoteNoteEditor", fields: [last_editor_tech_id], references: [id])
  last_editor_dispatcher dispatcher? @relation("QuoteNoteEditor", fields: [last_editor_dispatcher_id], references: [id])

  @@index([quote_id])
}

model job {
  id          String   @id @unique @default(uuid())
  organization_id String?
  organization    organization? @relation(fields: [organization_id], references: [id])
  job_number  String
  name        String
  description String   @db.Text
  priority    priority @default(Medium)
  address     String
  coords      Json

  status job_status @default(Unscheduled)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  status_changed_at   DateTime  @default(now())
  completed_at        DateTime?
  cancelled_at        DateTime?
  cancellation_reason String?

  client_id String
  client    client @relation(fields: [client_id], references: [id])
  request_id String?  
  request    request? @relation(fields: [request_id], references: [id])
  quote_id String? @unique // One job per quote
  quote    quote?  @relation(fields: [quote_id], references: [id])
  recurring_plan_id String? @unique
  recurring_plan    recurring_plan? @relation(fields: [recurring_plan_id], references: [id])
  project_id        String? 
  project           project? @relation(fields: [project_id], references: [id])

  // Financial totals for non-recurring jobs OR
  // aggregated values for recurring job containers
  // For recurring: estimated_total = quote/template total
  // For recurring: actual_total = SUM(completed visit totals)
  subtotal        Decimal  @default(0) @db.Decimal(10, 2)
  tax_rate        Decimal  @default(0) @db.Decimal(5, 4)
  tax_amount      Decimal  @default(0) @db.Decimal(10, 2)
  discount_type   discount_type?
  discount_value  Decimal? @db.Decimal(10, 2)
  discount_amount Decimal? @db.Decimal(10, 2)
  estimated_total Decimal? @db.Decimal(10, 2)
  actual_total    Decimal? @db.Decimal(10, 2)
  tax_snapshot    Json?

  visits       job_visit[]
  notes        job_note[]
  line_items   job_line_item[]
  invoice_jobs invoice_job[]
  field_purchase_allocations field_purchase_job_allocation[]
  purchase_allocations purchase_job_allocation[]

  @@index([client_id])
  @@index([recurring_plan_id])
  @@index([request_id])
  @@index([quote_id])
  @@index([status])
  @@index([priority])
  @@index([created_at])
  @@index([updated_at])
  @@index([project_id])

  @@index([client_id, status])
  @@index([organization_id, status])
  @@index([organization_id, created_at])
  @@unique([organization_id, job_number])
}

model job_line_item {
  id     String @id @default(uuid())
  job_id String
  job    job    @relation(fields: [job_id], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  quantity    Decimal @db.Decimal(10, 2)
  unit_price  Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  source       line_item_source
  item_type    line_item_type?
  tax_group_id String?
  tax_group    tax_group? @relation(fields: [tax_group_id], references: [id], onDelete: SetNull)
  taxable      Boolean    @default(true)
  tax_amount   Decimal?   @db.Decimal(10, 2)

  // Reference only; consumption is always visit-scoped.
  inventory_item_id String?
  inventory_item    inventory_item? @relation("JobLineItemInventory", fields: [inventory_item_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())

  @@index([job_id])
  @@index([inventory_item_id])
}

model job_visit {
  id     String @id @default(uuid())
  job_id String
  job    job    @relation(fields: [job_id], references: [id], onDelete: Cascade)

  name        String?  
  description String?  @db.Text 

  arrival_constraint   arrival_constraint
  finish_constraint    finish_constraint
  
  scheduled_start_at   DateTime
  scheduled_end_at     DateTime
  
  arrival_time         String? // For arrival_constraint = "at"
  arrival_window_start String? // For arrival_constraint = "between"
  arrival_window_end   String? // For arrival_constraint = "between" or "by"
  finish_time          String? // For finish_constraint = "at" or "by"

  actual_start_at      DateTime?
  actual_end_at        DateTime?

  estimated_drive_miles Float?
  estimated_return_drive_miles Float?

  status              visit_status @default(Scheduled)
  cancellation_reason String?

  subtotal        Decimal  @default(0) @db.Decimal(10, 2)
  tax_rate        Decimal  @default(0) @db.Decimal(5, 4)
  tax_amount      Decimal  @default(0) @db.Decimal(10, 2)
  discount_type   discount_type?
  discount_value  Decimal? @db.Decimal(10, 2)
  discount_amount Decimal? @db.Decimal(10, 2)
  total           Decimal  @default(0) @db.Decimal(10, 2)
  tax_snapshot    Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  visit_techs            job_visit_technician[]
  notes                  job_note[]              @relation("VisitNotes")
  recurring_occurrence   recurring_occurrence?   @relation("OccurrenceVisit")
  line_items             job_visit_line_item[]
  time_entries           visit_tech_time_entry[]
  drives                 visit_tech_drive[]
  invoice_visits         invoice_visit[]
  vehicle_stock_usages   vehicle_stock_usage[]
  stock_movements        stock_movement[]
  consumed_serial_units  serial_unit[]
  field_purchase_allocations field_purchase_job_allocation[]
  purchase_allocations purchase_job_allocation[]

  @@index([job_id])
  @@index([status])
  @@index([scheduled_start_at])
  @@index([scheduled_end_at])
  @@index([job_id, scheduled_start_at])
  @@index([status, actual_end_at])
}

model job_visit_line_item {
  id        String   @id @default(uuid())

  visit_id  String
  visit     job_visit @relation(fields: [visit_id], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  quantity    Decimal @db.Decimal(10, 2)
  unit_price  Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  source    line_item_source
  item_type line_item_type?

  inventory_item_id String?
  inventory_item    inventory_item? @relation(fields: [inventory_item_id], references: [id])

  // Plan + reconcile lifecycle (only set when inventory_item_id is set)
  fulfillment_status    line_item_fulfillment?
  qty_planned           Decimal?  @db.Decimal(10, 2)
  reconciled_at         DateTime?
  reconciled_by_tech_id String?

  // NULL reads as `consume` - what every linked line did before this column.
  disposition            line_item_disposition?
  // `receive` only. Vehicle is its own column so the FK is enforceable.
  disposition_location   stock_location_type?
  disposition_vehicle_id String?
  disposition_vehicle    vehicle?               @relation("VisitLineDispositionVehicle", fields: [disposition_vehicle_id], references: [id], onDelete: SetNull)

  tax_group_id    String?
  tax_group       tax_group? @relation(fields: [tax_group_id], references: [id], onDelete: SetNull)
  taxable         Boolean    @default(true)
  tax_amount      Decimal?   @db.Decimal(10, 2)

  sort_order Int @default(0)
  created_at DateTime @default(now())
  time_entry visit_tech_time_entry?
  stock_movements stock_movement[]
  consumed_serial_units serial_unit[]
  field_purchase_line field_purchase_line?
  purchase_line purchase_line?

  @@index([visit_id])
  @@index([sort_order])
  @@index([inventory_item_id])
  @@index([visit_id, fulfillment_status])
  @@index([disposition_vehicle_id])
}

model job_visit_technician {
  visit_id    String
  tech_id     String
  tech_status tech_visit_status @default(Assigned)
  visit       job_visit  @relation(fields: [visit_id], references: [id], onDelete: Cascade)
  tech        technician @relation(fields: [tech_id], references: [id])

  @@id([visit_id, tech_id])
  @@index([tech_id])
  @@index([visit_id])
}

model visit_tech_time_entry {
