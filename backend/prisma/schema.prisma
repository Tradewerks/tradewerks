  creator_dispatcher     dispatcher? @relation("ProjectNoteCreator", fields: [creator_dispatcher_id], references: [id])
  last_editor_tech       technician? @relation("ProjectNoteEditor", fields: [last_editor_tech_id], references: [id])
  last_editor_dispatcher dispatcher? @relation("ProjectNoteEditor", fields: [last_editor_dispatcher_id], references: [id])

