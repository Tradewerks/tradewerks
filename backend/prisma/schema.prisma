// ============================================================================
// INVENTORY 
// ============================================================================

model inventory_item {
  id          String @id @unique @default(uuid())
  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id])
  name        String
  description String @db.Text
  // Optional: a purchase order can land on the receiving floor before anyone
  // has decided where the item lives. Not stock-bearing — this is a findability
  // label, unrelated to stock_location_type.
  location    String?
  // Fractional on purpose: the unit catalog sells ft / m / lb / kg / gal / L, so
  // 12.5 ft of line set is an ordinary warehouse level. Matches the precision
  // every other quantity in the ledger already uses (stock_movement.qty,
  // vehicle_stock_item.qty_on_hand, stock_batch.qty_*) — this column was the last
  // integer holdout. Still a CACHED value, written only by recordMovements().
  quantity    Decimal @default(0) @db.Decimal(10, 2)

  unit_price Decimal? @db.Decimal(10, 2)
  cost       Decimal? @db.Decimal(10, 2)
  sku        String?
  barcode    String? // Physical label code (UPC, EAN, Code128, Code39, QR)
  is_active  Boolean  @default(true)
  is_serialized    Boolean @default(false)
  is_batch_tracked Boolean @default(false)
  low_stock_threshold Decimal? @db.Decimal(10, 2)
  provisional         Boolean   @default(false)
  // Default only catches write paths added later; every known creator sets it.
  origin              inventory_item_origin @default(dispatch_quick_add)
  created_by_tech_id  String?
  created_by_tech     technician? @relation("TechProvisionalItems", fields: [created_by_tech_id], references: [id], onDelete: SetNull)
  approved_at         DateTime?
  approved_by_id      String?
  approved_by         dispatcher? @relation("DispatcherApprovedItems", fields: [approved_by_id], references: [id], onDelete: SetNull)
  image_keys          String[] @default([])
  alt_ids             String[] @default([])

  image_urls           String[]  @default([])
  alert_emails_enabled Boolean   @default(false)
  alert_email          String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  category       String?              // freetext, org-defined — no static enum
  // Unit of MEASURE, not a serial_unit. Typed app-level: a TS union plus a Zod
  // enum at the API boundary (lib/units.ts + lib/validate/inventory.ts), with the
  // column left String so unknown legacy values still read back and adding a unit
  // needs no migration. Not a Prisma enum for exactly those reasons.
  unit           String  @default("each")

  visit_line_items job_visit_line_item[]
  vehicle_stocks   vehicle_stock_item[]
  quote_line_items          quote_line_item[]          @relation("QuoteLineItemInventory")
  job_line_items            job_line_item[]            @relation("JobLineItemInventory")
  recurring_plan_line_items recurring_plan_line_item[] @relation("RecurringPlanLineItemInventory")
  tags             inventory_tag[]
  stock_movements  stock_movement[]
  external_mappings item_external_mapping[]
  supplier_items    supplier_item[]
  invoice_line_items invoice_line_item[]
  serial_units     serial_unit[]
  stock_batches    stock_batch[]
  field_purchase_lines field_purchase_line[]
  purchase_lines purchase_line[]

  @@unique([organization_id, sku])
  @@unique([organization_id, barcode])
  @@index([sku])
  @@index([barcode])
  @@index([is_active])
  @@index([organization_id])
  @@index([created_at])
}

// Terminal state of the reconcile queue. Name-scoped, matching the backfill
// beside it. Attributed and reversible because dismissal is the lazy way out.
model unmapped_part_decision {
  id              String       @id @default(uuid())
  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id])
  // Folded as the matcher folds it, so "3/4 Copper" and "3/4 copper " are one.
  folded_name     String
  decided_by_id   String?
  decided_by      dispatcher?  @relation(fields: [decided_by_id], references: [id], onDelete: SetNull)
  decided_at      DateTime     @default(now())
  reason          String?      @db.Text

  @@unique([organization_id, folded_name])
  @@index([organization_id])
}

model item_external_mapping {
  id                String @id @default(uuid())
  inventory_item_id String
  provider          String
  external_id       String
  account_id        String @default("")
  inventory_item    inventory_item @relation(fields: [inventory_item_id], references: [id], onDelete: Cascade)

  @@unique([provider, external_id, account_id])
  @@unique([provider, inventory_item_id, account_id])
  @@index([inventory_item_id])
}

model inventory_tag {
  id              String   @id @default(uuid())
  organization_id String
  label           String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  items        inventory_item[]

  @@unique([organization_id, label])
  @@index([organization_id])
}


// ============================================================================
// VEHICLES + VEHICLE STOCK
// ============================================================================

enum vehicle_maintenance_category {
  oil_change
  fluids
  tire
  brake
  inspection
  registration
  repair
  other
}

enum interval_unit {
  days
  weeks
  months
  years
}

model vehicle {
  id              String        @id @default(uuid())
  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id])
  name            String
  type            String        // freetext: "van", "truck", "sedan", etc.
  license_plate   String?
  year            Int?
  make            String?
  model           String?
  status          String        @default("active") // "active" | "inactive"
  color           String?       // freetext: "Pearl White", "Fleet Blue", etc.
  notes           String?       @db.Text
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  current_odometer_mi Int?
  odometer_updated_at DateTime?

  stored_at         String?
  stored_at_coords  Json?

  stock_items         vehicle_stock_item[]
  current_technicians technician[]         @relation("CurrentVehicle")
  restock_records     vehicle_restock_record[] @relation("VehicleRestockRecords")
  adjustments         vehicle_stock_adjustment[] @relation("VehicleAdjustments")
  readiness_records   vehicle_readiness[]
  maintenance_records vehicle_maintenance_record[]
  maintenance_reminders vehicle_maintenance_reminder[]
  movements_from      stock_movement[]     @relation("MovementFromVehicle")
  movements_to        stock_movement[]     @relation("MovementToVehicle")
  serial_units        serial_unit[]
  stock_batches       vehicle_stock_batch[]
  visit_line_dispositions job_visit_line_item[]      @relation("VisitLineDispositionVehicle")
  plan_line_dispositions  recurring_plan_line_item[] @relation("PlanLineDispositionVehicle")
  field_purchase_line_dispositions field_purchase_line[] @relation("FieldPurchaseLineDispositionVehicle")
  purchase_line_dispositions purchase_line[] @relation("PurchaseLineDispositionVehicle")

  @@index([organization_id])
  @@index([status])
}

model vehicle_stock_item {
  id                String         @id @default(uuid())
  vehicle_id        String
  vehicle           vehicle        @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  inventory_item_id String
  inventory_item    inventory_item @relation(fields: [inventory_item_id], references: [id])
  qty_on_hand       Decimal        @default(0) @db.Decimal(10, 2)
  qty_min           Decimal        @default(0) @db.Decimal(10, 2)
  qty_standard      Decimal?       @db.Decimal(10, 2)
  updated_at        DateTime       @updatedAt
  created_at        DateTime       @default(now())

  usage_records     vehicle_stock_usage[]
  restock_requests  vehicle_restock_request[]
  restock_lines     vehicle_restock_line[] @relation("StockItemRestockLines")
  adjustment_lines  vehicle_stock_adjustment_line[] @relation("StockItemAdjustmentLines")

  @@unique([vehicle_id, inventory_item_id])
  @@index([vehicle_id])
  @@index([inventory_item_id])
}

model vehicle_stock_usage {
  id                 String             @id @default(uuid())
  stock_item_id      String
  stock_item         vehicle_stock_item @relation(fields: [stock_item_id], references: [id])
  visit_id           String
  visit              job_visit          @relation(fields: [visit_id], references: [id])
  technician_id      String
  qty_used           Decimal            @db.Decimal(10, 2)
  visit_line_item_id String?            // FK to job_visit_line_item created alongside usage
  created_at         DateTime           @default(now())

  @@index([stock_item_id])
  @@index([visit_id])
  @@index([technician_id])
}

model vehicle_restock_record {
  id              String     @id @default(uuid())
  organization_id String
  vehicle_id      String
  vehicle         vehicle    @relation("VehicleRestockRecords", fields: [vehicle_id], references: [id], onDelete: Cascade)
  completed_at    DateTime
  day             DateTime   @db.Date
  mode            restock_record_mode @default(restock)
  completed_by_id String?
  completed_by    dispatcher? @relation("DispatcherRestockRecords", fields: [completed_by_id], references: [id])
  completed_by_tech_id String?
  completed_by_tech    technician? @relation("TechnicianRestockRecords", fields: [completed_by_tech_id], references: [id])
  notes           String?
  created_at      DateTime   @default(now())

  restock_lines    vehicle_restock_line[]
  stock_movements  stock_movement[]
  readiness_record vehicle_readiness? @relation("RestockReadiness")

  @@index([vehicle_id])
  @@index([organization_id])
  @@index([completed_at])
}

model vehicle_restock_line {
  id               String                 @id @default(uuid())
  restock_record_id String
  restock_record   vehicle_restock_record @relation(fields: [restock_record_id], references: [id], onDelete: Cascade)
  stock_item_id    String
  stock_item       vehicle_stock_item     @relation("StockItemRestockLines", fields: [stock_item_id], references: [id])
  qty_restocked    Decimal                @default(0) @db.Decimal(10, 2)
  qty_shortfall    Decimal                @default(0) @db.Decimal(10, 2)
  created_at       DateTime               @default(now())

  @@index([restock_record_id])
  @@index([stock_item_id])
}

model vehicle_stock_adjustment {
  id              String                  @id @default(uuid())
  organization_id String
  vehicle_id      String
  vehicle         vehicle                 @relation("VehicleAdjustments", fields: [vehicle_id], references: [id], onDelete: Cascade)
  type            vehicle_adjustment_type
  note            String?
  created_by_id   String?
  created_by      dispatcher?             @relation("DispatcherAdjustments", fields: [created_by_id], references: [id])
  created_by_tech_id String?
  created_by_tech    technician?          @relation("TechnicianAdjustments", fields: [created_by_tech_id], references: [id])
  created_at      DateTime               @default(now())

  lines vehicle_stock_adjustment_line[]
  stock_movements stock_movement[]

  @@index([vehicle_id])
  @@index([organization_id])
  @@index([created_at])
}

model vehicle_stock_adjustment_line {
  id               String                  @id @default(uuid())
  adjustment_id    String
  adjustment       vehicle_stock_adjustment @relation(fields: [adjustment_id], references: [id], onDelete: Cascade)
  stock_item_id    String
  stock_item       vehicle_stock_item      @relation("StockItemAdjustmentLines", fields: [stock_item_id], references: [id])
  qty_before       Decimal                 @db.Decimal(10, 2)
  qty_after        Decimal                 @db.Decimal(10, 2)
  inventory_impact Decimal                 @default(0) @db.Decimal(10, 2)

  @@index([adjustment_id])
  @@index([stock_item_id])
}

model vehicle_restock_request {
  id              String             @id @default(uuid())
  organization_id String
  stock_item_id   String
  stock_item      vehicle_stock_item @relation(fields: [stock_item_id], references: [id])
  technician_id   String
  qty_requested   Decimal?           @db.Decimal(10, 2)
  note            String?
  status          String             @default("pending") // "pending" | "acknowledged" | "resolved" | "dismissed"
  created_at      DateTime           @default(now())
  acknowledged_at   DateTime?
  acknowledged_by_id String?
  acknowledged_by    dispatcher? @relation("DispatcherAcknowledgedRequests", fields: [acknowledged_by_id], references: [id])
  resolved_at     DateTime?
  resolved_note   String?
  dismissed_reason String?

  // Partial unique index enforced in SQL migration (Prisma does not support WHERE clause):
  // CREATE UNIQUE INDEX vrr_one_pending_per_item ON vehicle_restock_request (stock_item_id) WHERE status = 'pending'
  @@index([organization_id])
  @@index([stock_item_id])
  @@index([technician_id])
  @@index([status])
}

model vehicle_maintenance_record {
  id              String       @id @default(uuid())
  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id])
  vehicle_id      String
  vehicle         vehicle      @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)

  category     vehicle_maintenance_category
  performed_at DateTime
  odometer_mi  Int?

  interval_miles  Int? // null = no reminder computed for this category
  interval_months Int?

  cost        Decimal? @db.Decimal(10, 2)
  vendor_name String?
  notes       String?  @db.Text

  performed_by_id      String?
  performed_by         dispatcher? @relation("DispatcherPerformedMaintenance", fields: [performed_by_id], references: [id])
  performed_by_tech_id String?
  performed_by_tech    technician? @relation("TechPerformedMaintenance", fields: [performed_by_tech_id], references: [id])

  source_purchase_line_id       String?
  source_purchase_line          purchase_line?       @relation(fields: [source_purchase_line_id], references: [id], onDelete: SetNull)
  source_field_purchase_line_id String?
  source_field_purchase_line    field_purchase_line? @relation(fields: [source_field_purchase_line_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([vehicle_id])
  @@index([organization_id])
  @@index([category])
  @@index([performed_at])
}

model vehicle_maintenance_reminder {
  id              String       @id @default(uuid())
  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id])
  vehicle_id      String
  vehicle         vehicle      @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)

  category        vehicle_maintenance_category
  title           String 
  description     String?

  interval_miles  Int?
  interval_unit   interval_unit?
  interval_count  Int?

  repeats         Boolean   @default(true)
  due_at          DateTime? // one-time only: fixed date target
  due_odometer_mi Int?      // one-time only: fixed mileage target
  completed_at    DateTime? // one-time only: set when dismissed/fulfilled

  // dispatcher has seen it and muted its urgency — does not affect the due calc
  acknowledged_at DateTime?

  // repeating only: due-calc anchor — set at creation, moved when a record covers this reminder
  baseline_at          DateTime?
  baseline_odometer_mi Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([vehicle_id])
  @@index([organization_id])
  @@index([category])
}

// ============================================================================
// SUPPLIERS (vendor origin for purchased stock)
// ============================================================================

model supplier {
  id              String       @id @default(uuid())
  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id])

  // As typed by whoever received the stock — this is what the UI shows.
  name     String
  // Lowercased, whitespace-collapsed `name`. The dedupe key, and the reason
  // the unique index below can exist: it folds "Ferguson " and "ferguson" into
  // one vendor WITHOUT fuzzy matching, which would wrongly fold "Ferguson"
  // into "Ferguson Plumbing" — a different company that bills different prices.
  name_key String

  account_number String?
  contact_name   String?
  phone          String?
  email          String?
  notes          String? @db.Text
  // Retire a vendor without rewriting history: deactivating hides it from the
  // pickers while every movement that names it keeps resolving.
  is_active      Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  movements         stock_movement[]
  batches           stock_batch[]
  external_mappings supplier_external_mapping[]
  items             supplier_item[]
  field_purchases   field_purchase[]
  purchases         purchase[]

  @@unique([organization_id, name_key])
  @@index([organization_id, is_active])
}

// Same shape as client_external_mapping / item_external_mapping — one convention
// for "this local row is that provider's row", so a second accounting provider
// costs a row here rather than another column on `supplier`.
model supplier_external_mapping {
  id          String @id @default(uuid())
  supplier_id String
  provider    String
  account_id  String @default("")
  external_id String

  supplier supplier @relation(fields: [supplier_id], references: [id], onDelete: Cascade)

  // Neither side can be double-linked: one QBO vendor maps to one supplier, and
  // one supplier maps to one QBO vendor, per connected company file.
  @@unique([provider, account_id, external_id])
  @@unique([provider, supplier_id, account_id])
  @@index([supplier_id])
}

// What a given vendor charges for a given item. The catalog that lets the
// reorder forecast say WHO to buy from and at WHAT price instead of dead-ending
// at a quantity.
model supplier_item {
  id                String         @id @default(uuid())
  organization_id   String
  organization      organization   @relation(fields: [organization_id], references: [id])
  supplier_id       String
  supplier          supplier       @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  inventory_item_id String
  inventory_item    inventory_item @relation(fields: [inventory_item_id], references: [id], onDelete: Cascade)

  // The vendor's own part number — what you read off their quote and order by.
  // Rarely the same string as our SKU.
  vendor_sku String?

  // Negotiated rate, entered by hand. Beats last_price in the forecast: a
  // contract is what you WILL pay, an observation is what you happened to pay.
  contract_price Decimal? @db.Decimal(10, 2)

  // Written by recordMovements on every intake movement that names this vendor
  // and carries a cost. A price list nobody maintains by hand is the only kind
  // that stays true, so this one maintains itself.
  last_price        Decimal?  @db.Decimal(10, 2)
  last_purchased_at DateTime?

  // Exactly one preferred vendor per item, enforced on write AND by a partial
  // unique index (inventory_item_id WHERE is_preferred) added by hand in the
  // migration — Prisma's DSL can't express a partial index, so this line will
  // always look unenforced from here alone. The forecast has to name one
  // vendor per item or it isn't actionable.
  is_preferred Boolean @default(false)

  lead_time_days Int?
  min_order_qty  Decimal? @db.Decimal(10, 2)
  notes          String?  @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([supplier_id, inventory_item_id])
  @@index([organization_id, inventory_item_id])
  @@index([inventory_item_id, is_preferred])
}

// Standalone lifecycle for a planned vendor purchase - distinct from
// field_purchase_status, which is built around tech-spend authority
// (preauth/second-signoff) that doesn't apply to a dispatcher-ordered PO.
enum purchase_status {
  draft
  ordered
  partially_received
  received
  cancelled
}

// Standalone from field_purchase_kind so the two features can evolve independently,
// even though both currently just distinguish a purchase from its refund.
enum purchase_kind {
  purchase
  refund
}

model purchase {
  id              String          @id @default(uuid())
  organization_id String
  organization    organization    @relation(fields: [organization_id], references: [id])
  status          purchase_status @default(draft)
  kind            purchase_kind   @default(purchase)
  purchase_number String

  vendor_name String?
  supplier_id String?
  supplier    supplier? @relation(fields: [supplier_id], references: [id], onDelete: SetNull)

  purchased_at DateTime?
  subtotal     Decimal   @default(0) @db.Decimal(10, 2)
  tax_group_id String?
  tax_group    tax_group? @relation(fields: [tax_group_id], references: [id], onDelete: SetNull)
  tax_amount   Decimal   @default(0) @db.Decimal(10, 2)
  total        Decimal   @default(0) @db.Decimal(10, 2)

  submitted_at         DateTime?
  cancelled_at         DateTime?
  cancellation_reason  String?

  flags Json @default("[]")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  qb_purchase_id String?
  qb_sync_status qb_sync_status @default(not_synced)
  account_id     String         @default("")

  lines       purchase_line[]
  allocations purchase_job_allocation[]
  events      purchase_event[]

  @@index([organization_id, status])
  // The duplicate and velocity checks both sweep one vendor's recent purchases.
  @@index([organization_id, vendor_name, purchased_at])
  @@index([supplier_id])
  @@unique([account_id, qb_purchase_id])
}

model purchase_line {
  id                String         @id @default(uuid())
  purchase_id String
  purchase    purchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)

  description String
  quantity    Decimal @db.Decimal(10, 2)
  unit_price  Decimal @db.Decimal(10, 2)
  line_total  Decimal @db.Decimal(10, 2)

  inventory_item_id String?
  inventory_item    inventory_item? @relation(fields: [inventory_item_id], references: [id], onDelete: SetNull)
  disposition            line_item_disposition?
  disposition_location   stock_location_type?
  disposition_vehicle_id String?
  disposition_vehicle    vehicle?               @relation("PurchaseLineDispositionVehicle", fields: [disposition_vehicle_id], references: [id], onDelete: SetNull)

  quantity_recieved      Decimal @default(0) @db.Decimal(10, 2)
  received_at            DateTime?

  ocr_confidence Decimal? @db.Decimal(4, 3)

  verified_at DateTime?

  visit_line_item_id String?              @unique
  visit_line_item    job_visit_line_item? @relation(fields: [visit_line_item_id], references: [id], onDelete: SetNull)

  // Only valid on a non_stock line - a receive line lands in general stock and
  // gets job-costed later, when it's actually consumed, not at purchase time.
  // enforced the same way disposition's `consume` ban is: application validation.
  allocation_id String?
  allocation    purchase_job_allocation? @relation(fields: [allocation_id], references: [id], onDelete: SetNull)

  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  movements stock_movement[]
  maintenance_records vehicle_maintenance_record[]

  @@index([purchase_id])
  @@index([inventory_item_id])
  @@index([disposition_vehicle_id])
  @@index([allocation_id])
}

model purchase_job_allocation {
  id                String         @id @default(uuid())
  purchase_id String
  purchase    purchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  job_id            String
  job               job            @relation(fields: [job_id], references: [id], onDelete: Cascade)

  // The visit the technician was standing on when they bought. Billing needs a
  // visit and the job alone does not name one; null when the purchase was
  // started from somewhere with no visit in context.
  job_visit_id String?
  job_visit    job_visit? @relation(fields: [job_visit_id], references: [id], onDelete: SetNull)

  // Derived, never typed: the sum of the lines assigned to this job plus its
  // pro-rata share of the tax. An amount somebody types is a second answer to a
  // question the lines already answer, and the two drift.
  amount Decimal @db.Decimal(10, 2)

  lines purchase_line[]

  created_at DateTime @default(now())

  @@unique([purchase_id, job_id])
  @@index([job_id])
  @@index([job_visit_id])
}

// Append-only, mirrors field_purchase_event's shape for the regular-purchase side.
model purchase_event {
  id              String        @id @default(uuid())
  organization_id String
  organization    organization  @relation(fields: [organization_id], references: [id])
  purchase_id     String?
  purchase        purchase?     @relation(fields: [purchase_id], references: [id], onDelete: Cascade)

  type       String
  actor_type String // "dispatcher" | "system"
  actor_id   String?
  detail     Json    @default("{}")

  at DateTime @default(now())

  @@index([organization_id, at])
  @@index([purchase_id, at])
}

  // ============================================================================
  // FIELD PROCUREMENT (emergency purchases, reimbursement model)
  // Receipt lines reuse line_item_disposition rather than a second vocabulary.
  // Approval writes the stock effect for `receive` lines only; QuickBooks posting
  // is deliberately absent (a later stage owns it).
  // ============================================================================

model field_purchase_grant {
  id              String       @id @default(uuid())
  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id])
  technician_id   String
  technician      technician   @relation(fields: [technician_id], references: [id], onDelete: Cascade)

  // Authority is per-technician and revocable, NOT a role: the role permission
  // `request_field_purchase` only gates reaching the flow, these limits are what
  // bound the money. Senior techs carry higher ceilings on their own row.
  per_transaction_limit Decimal  @db.Decimal(10, 2)
  daily_limit           Decimal? @db.Decimal(10, 2)
  weekly_limit          Decimal? @db.Decimal(10, 2)
  per_job_limit         Decimal? @db.Decimal(10, 2)

  // Revoked, never deleted: a purchase already in flight when authority is
  // pulled still has to reconcile.
  is_active     Boolean     @default(true)
  granted_by_id String?
  granted_by    dispatcher? @relation("GrantedFieldPurchaseGrants", fields: [granted_by_id], references: [id], onDelete: SetNull)
  granted_at    DateTime    @default(now())
  revoked_by_id String?
  revoked_by    dispatcher? @relation("RevokedFieldPurchaseGrants", fields: [revoked_by_id], references: [id], onDelete: SetNull)
  revoked_at    DateTime?
  notes         String?     @db.Text

  updated_at DateTime @updatedAt

  events field_purchase_event[]

  // One row per tech. Every grant/revoke lands in field_purchase_event, so the
  // history is append-only there rather than a pile of superseded grant rows.
  @@unique([organization_id, technician_id])
  @@index([organization_id, is_active])
}

model field_purchase {
  id              String                @id @default(uuid())
  organization_id String
  organization    organization          @relation(fields: [organization_id], references: [id])
  technician_id   String
  technician      technician            @relation(fields: [technician_id], references: [id])
  status          field_purchase_status @default(draft)
  kind            field_purchase_kind   @default(purchase)

  // Set only on a refund. Its own lines mirror the parent's, so an approval can
  // reverse exactly the stock the parent brought in.
  parent_purchase_id String?
  parent_purchase    field_purchase?  @relation("FieldPurchaseRefunds", fields: [parent_purchase_id], references: [id], onDelete: SetNull)
  refunds            field_purchase[] @relation("FieldPurchaseRefunds")
  // Stamped when the money actually came back. Until then the parent carries a
  // flag: a credit promised at the counter is not a credit received.
  refund_settled_at DateTime?

  // Also copied into the event log; see the note on `preauth_note`.
  reason String? @db.Text
  // Pre-authorization is asked against an ESTIMATE, before the counter. The real
  // total may exceed it; that re-flags at submit rather than voiding the auth.
  estimated_amount Decimal? @db.Decimal(10, 2)

  // Vendor as it reads on the receipt.
  vendor_name String?
  // Resolved from the receipt when the vendor is one we already know. Stays NULL for
  // a counter nobody has set up as a supplier - normal for an emergency buy. Same
  // split as the ledger's supplier_id: the raw string is evidence, the FK is the join.
  supplier_id String?
  supplier    supplier? @relation(fields: [supplier_id], references: [id], onDelete: SetNull)

  purchased_at DateTime?
  subtotal     Decimal   @default(0) @db.Decimal(10, 2)
  tax_amount   Decimal   @default(0) @db.Decimal(10, 2)
  total        Decimal   @default(0) @db.Decimal(10, 2)

  receipt_image_url String?
  // sha256 of the uploaded bytes, unique per ORG rather than globally - two orgs
  // can legitimately hold the same file. Reimbursement has no independent
  // upstream record, so receipt reuse is the primary fraud vector.
  receipt_image_hash String?
  // Device clock at capture, kept apart from purchased_at (what the receipt
  // claims) so the two can disagree and be flagged.
  captured_at DateTime?
  // Advisory only: GPS-grade on mobile, WiFi/IP-grade or absent on desktop, so a
  // divergence flags for attention and never blocks a submit.
  capture_lat        Decimal? @db.Decimal(9, 6)
  capture_lng        Decimal? @db.Decimal(9, 6)
  capture_accuracy_m Int?

  submitted_at         DateTime?
  preauth_requested_at DateTime?
  preauth_decided_at   DateTime?
  preauth_by_id        String?
  preauth_by           dispatcher? @relation("PreauthorizedFieldPurchases", fields: [preauth_by_id], references: [id], onDelete: SetNull)
  // This note, `review_note`, `second_signoff_note` and `reason` are copied
  // verbatim into field_purchase_event.detail as they are written, and nothing
  // updates or deletes an event row by design. Clearing the column therefore does
  // not remove the text - it lives for the life of the event log. Any retention
  // policy that claims otherwise is false on its face.
  preauth_note         String?     @db.Text
  reviewed_at          DateTime?
  reviewed_by_id       String?
  reviewed_by          dispatcher? @relation("ReviewedFieldPurchases", fields: [reviewed_by_id], references: [id], onDelete: SetNull)
  review_note          String?     @db.Text
  second_signoff_at    DateTime?
  second_signoff_by_id String?
  second_signoff_by    dispatcher? @relation("SecondSignedFieldPurchases", fields: [second_signoff_by_id], references: [id], onDelete: SetNull)
  second_signoff_note  String?     @db.Text

  ocr_status   field_purchase_ocr_status @default(not_run)
  ocr_provider String?
  // The vendor's own number for the ticket, read off the receipt. Nullable forever:
  // plenty of receipts do not print one, and OCR may miss the ones that do.
  receipt_number String?
  // The provider payload exactly as returned. Kept whole because it is evidence:
  // a disputed line has to be answerable against what the vendor actually sent.
  // Vendor and purchase PII: never widen a projection to include it, and never
  // log it. Verified to contain no payment credentials: those are on the
  // receipt IMAGE, which is served only through signed URLs.
  ocr_raw Json?
  // { field: 0..1 } for the header fields. Below OCR_LOW_CONFIDENCE the tech's UI
  // marks the field for attention - it never relaxes the mandatory verification.
  ocr_field_confidence Json @default("{}")
  // Snapshot of the extracted lines. Editing replaces the whole line set, so this
  // is the only thing left to diff the tech's corrections against at submit.
  ocr_lines        Json?
  ocr_completed_at DateTime?
  ocr_error        String?   @db.Text
  ocr_line_count   Int?
  ocr_corrections  Int?

  // Deterministic check results as [{ code, message }], recomputed at submit.
  // Advisory: a flag routes dispatcher attention, it never rejects a purchase.
  flags Json @default("[]")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  qb_purchase_id String?
  qb_sync_status qb_sync_status @default(not_synced)
  account_id     String         @default("")

  lines       field_purchase_line[]
  allocations field_purchase_job_allocation[]
  events      field_purchase_event[]

  @@unique([organization_id, receipt_image_hash])
  @@index([organization_id, status])
  @@index([organization_id, technician_id, purchased_at])
  // The duplicate and velocity checks both sweep one vendor's recent purchases.
  @@index([organization_id, vendor_name, purchased_at])
  // Reserved for receipt-number lookup. No query uses it yet; the duplicate sweep
  // compares numbers in application code over a candidate set this does not serve.
  @@index([organization_id, vendor_name, receipt_number])
  @@index([parent_purchase_id])
  @@index([supplier_id])
  @@unique([account_id, qb_purchase_id])
}

model field_purchase_line {
  id                String         @id @default(uuid())
  field_purchase_id String
  field_purchase    field_purchase @relation(fields: [field_purchase_id], references: [id], onDelete: Cascade)

  description String
  quantity    Decimal @db.Decimal(10, 2)
  unit_price  Decimal @db.Decimal(10, 2)
  line_total  Decimal @db.Decimal(10, 2)

  // Mapping is optional and unmapped is terminal, not an error.
  inventory_item_id String?
  inventory_item    inventory_item? @relation(fields: [inventory_item_id], references: [id], onDelete: SetNull)
  // `receive` (lands in stock at cost) or `non_stock` (job cost, no stock
  // effect). `consume` is INVALID here and rejected by validation: a
  // field-bought part was never in our stock to deduct from.
  disposition            line_item_disposition?
  disposition_location   stock_location_type?
  disposition_vehicle_id String?
  disposition_vehicle    vehicle?               @relation("FieldPurchaseLineDispositionVehicle", fields: [disposition_vehicle_id], references: [id], onDelete: SetNull)

  // Null on any technician-entered line, which after an edit is every line in the
  // replaced set.
  ocr_confidence Decimal? @db.Decimal(4, 3)

  // Per-line and mandatory before submit, whether or not the line is mapped.
  verified_at DateTime?

  // The billable visit row this line produced at submit. Unique so a re-submit
  // settles the same row instead of billing the customer twice.
  visit_line_item_id String?              @unique
  visit_line_item    job_visit_line_item? @relation(fields: [visit_line_item_id], references: [id], onDelete: SetNull)

  // Which job's share this line is. The allocation rather than the job directly:
  // it already carries the visit billing needs, and a second copy of the job is a
  // second thing to keep in step.
  allocation_id String?
  allocation    field_purchase_job_allocation? @relation(fields: [allocation_id], references: [id], onDelete: SetNull)

  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  movements stock_movement[]
  maintenance_records vehicle_maintenance_record[]

  @@index([field_purchase_id])
  @@index([inventory_item_id])
  @@index([disposition_vehicle_id])
  @@index([allocation_id])
}

model field_purchase_job_allocation {
  id                String         @id @default(uuid())
  field_purchase_id String
  field_purchase    field_purchase @relation(fields: [field_purchase_id], references: [id], onDelete: Cascade)
  job_id            String
  job               job            @relation(fields: [job_id], references: [id], onDelete: Cascade)

  // The visit the technician was standing on when they bought. Billing needs a
  // visit and the job alone does not name one; null when the purchase was
  // started from somewhere with no visit in context.
  job_visit_id String?
  job_visit    job_visit? @relation(fields: [job_visit_id], references: [id], onDelete: SetNull)

  // Derived, never typed: the sum of the lines assigned to this job plus its
  // pro-rata share of the tax. An amount somebody types is a second answer to a
  // question the lines already answer, and the two drift.
  amount Decimal @db.Decimal(10, 2)

  lines field_purchase_line[]

  created_at DateTime @default(now())

  @@unique([field_purchase_id, job_id])
  @@index([job_id])
  @@index([job_visit_id])
}

// Append-only. Nothing updates or deletes a row here; a correction is another
// row. Grants and purchases share the table so one query answers "what happened
// to this technician's authority and spend".
model field_purchase_event {
  id                String                @id @default(uuid())
  organization_id   String
  organization      organization          @relation(fields: [organization_id], references: [id])
  field_purchase_id String?
  field_purchase    field_purchase?       @relation(fields: [field_purchase_id], references: [id], onDelete: Cascade)
  grant_id          String?
  grant             field_purchase_grant? @relation(fields: [grant_id], references: [id], onDelete: Cascade)

  type       String
  actor_type String  // "technician" | "dispatcher" | "system"
  actor_id   String?
  // Per-event payload, shaped by the event type - never a uniform diff.
  // An edit writes `{ fields: [name] }`: which fields changed, not what they
  // changed from and to. Deliberate, because this log is append-only and never
  // purged, so a before/after value written here would outlive every retention
  // window the column it came from is subject to.
  detail     Json    @default("{}")

  at DateTime @default(now())

  @@index([organization_id, at])
  @@index([field_purchase_id, at])
  @@index([grant_id, at])
}

// ============================================================================
// STOCK MOVEMENT LEDGER
// Source of truth for all inventory changes. Cached quantities
// (inventory_item.quantity, vehicle_stock_item.qty_on_hand) are derived and
// updated only by services/stockMovements.recordMovements() in the same tx.
// ============================================================================

model stock_movement {
  id                String       @id @default(uuid())
  organization_id   String
  organization      organization @relation(fields: [organization_id], references: [id])
  inventory_item_id String
  inventory_item    inventory_item @relation(fields: [inventory_item_id], references: [id])
  qty               Decimal      @db.Decimal(10, 2) // strictly positive; direction is from→to
  // Unit of measure `qty` is denominated in, STAMPED at write time by
  // recordMovements() from the item's unit inside the same transaction. Never
  // derived from inventory_item at read time, and never caller-supplied.
  //
  // Before this column existed, every row was implicitly denominated in the item's
  // CURRENT unit, so changing an item from `each` to `box` silently reinterpreted
  // years of ledger rows — consumption charts, WAC and runway all shifted with no
  // migration and no warning. Existing rows were backfilled from the item's unit,
  // which writes down the semantics the code already assumed rather than inventing
  // a new claim. A ledger spanning a unit change is now detectable, so aggregates
  // flag a mixed-unit series instead of summing across units.
  unit              String
  // What supplier actually billed PER UNIT for this movement. Only ever set
  // on intake movements (reason 'receive' / 'supplier_purchase'); omit elsewhere.
  unit_cost         Decimal?     @db.Decimal(10, 2)
  // WHO the stock was bought from. Same contract as unit_cost directly above:
  // only ever set on intake movements, dropped by recordMovements() elsewhere.
  //
  // Nullable forever, not just until backfill. Before this column the only
  // supplier anywhere was stock_batch.supplier — free text captured solely when
  // a NEW lot was created, so a plain non-batch-tracked receive recorded no
  // origin at all. Those rows stay NULL on purpose: the vendor genuinely was
  // never written down, and inferring one would corrupt the exact per-supplier
  // figures the cost history is meant to report.
  supplier_id       String?
  supplier          supplier?    @relation(fields: [supplier_id], references: [id])

  from_location_type stock_location_type
  from_vehicle_id    String?
  from_vehicle       vehicle? @relation("MovementFromVehicle", fields: [from_vehicle_id], references: [id])
  to_location_type   stock_location_type
  to_vehicle_id      String?
  to_vehicle         vehicle? @relation("MovementToVehicle", fields: [to_vehicle_id], references: [id])

  reason     stock_movement_reason
  note       String? @db.Text
  actor_type String  // "technician" | "dispatcher" | "system"
  actor_id   String?

  visit_id           String?
  visit              job_visit? @relation(fields: [visit_id], references: [id])
  visit_line_item_id String?
  visit_line_item    job_visit_line_item? @relation(fields: [visit_line_item_id], references: [id])
  restock_record_id  String?
  restock_record     vehicle_restock_record? @relation(fields: [restock_record_id], references: [id])
  adjustment_id      String?
  adjustment         vehicle_stock_adjustment? @relation(fields: [adjustment_id], references: [id])
  field_purchase_line_id String?
  field_purchase_line    field_purchase_line? @relation(fields: [field_purchase_line_id], references: [id])
  purchase_line_id String?
  purchase_line    purchase_line? @relation(fields: [purchase_line_id], references: [id])

  movement_serials   stock_movement_serial[]
  movement_batches   stock_movement_batch[]

  created_at DateTime @default(now())

  @@index([organization_id, inventory_item_id, created_at])
  @@index([organization_id, created_at])
  @@index([supplier_id, created_at])
  @@index([from_vehicle_id, created_at])
  @@index([to_vehicle_id, created_at])
  @@index([visit_id])
  @@index([restock_record_id])
  @@index([adjustment_id])
  @@index([field_purchase_line_id])
  @@index([purchase_line_id])
}

// ============================================================================
// SERIAL + BATCH TRACKING (per-unit + lot traceability)
// Cached quantities (stock_batch.qty_in_warehouse, vehicle_stock_batch.qty_on_hand)
// and serial_unit.status/current_vehicle_id/consumed_* are written ONLY by
// services/stockMovements.recordMovements() in the same tx.
// ============================================================================

model serial_unit {
  id                String @id @default(uuid())
  organization_id   String
  organization      organization @relation(fields: [organization_id], references: [id])
  inventory_item_id String
  inventory_item    inventory_item @relation(fields: [inventory_item_id], references: [id])
  serial_number     String // manufacturer serial (may collide across SKUs)
  code              String @unique @default(uuid()) // stable QR payload (short base32 assigned by app)
  status            serial_unit_status @default(in_warehouse)

  current_vehicle_id String?
  current_vehicle    vehicle? @relation(fields: [current_vehicle_id], references: [id])

  // Consumption snapshot (set on consume, cleared on reversal)
  consumed_at          DateTime?
  consumed_visit_id    String?
  consumed_visit       job_visit? @relation(fields: [consumed_visit_id], references: [id])
  consumed_line_item_id String?
  consumed_line_item   job_visit_line_item? @relation(fields: [consumed_line_item_id], references: [id])
  client_id            String? // denormalized visit→job→client at consumption for recall lookups
  client               client? @relation(fields: [client_id], references: [id])

  batch_id String?
  batch    stock_batch? @relation(fields: [batch_id], references: [id])

  received_at DateTime @default(now())
  note        String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  movement_serials stock_movement_serial[]

  @@unique([organization_id, inventory_item_id, serial_number])
  @@index([organization_id, status])
  @@index([inventory_item_id, status])
  @@index([current_vehicle_id])
  @@index([client_id])
  @@index([consumed_visit_id])
  @@index([batch_id])
  @@index([organization_id, serial_number])
}

model stock_batch {
  id                String @id @default(uuid())
  organization_id   String
  organization      organization @relation(fields: [organization_id], references: [id])
  inventory_item_id String
  inventory_item    inventory_item @relation(fields: [inventory_item_id], references: [id])
  batch_number      String
  code              String @unique @default(uuid()) // stable QR payload

  expires_at  DateTime? @db.Date
  // Legacy free-text vendor name. Superseded by supplier_id below and kept ONLY
  // as a read fallback for lots the backfill couldn't resolve to an entity
  // (blank, or a name that normalized into nothing). Never write it alone —
  // writers set both, so a future pass can drop this column with no data loss.
  supplier    String?
  supplier_id String?
  supplier_ref supplier? @relation(fields: [supplier_id], references: [id])
  unit_cost   Decimal?  @db.Decimal(10, 2)
  recalled_at DateTime? // recall flag blocks FIFO picks
  qty_received     Decimal @default(0) @db.Decimal(10, 2) // cumulative received
  qty_in_warehouse Decimal @default(0) @db.Decimal(10, 2) // cached — written ONLY by recordMovements

  received_at DateTime @default(now())
  note        String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  serial_units     serial_unit[]
  vehicle_batches  vehicle_stock_batch[]
  movement_batches stock_movement_batch[]

  @@unique([organization_id, inventory_item_id, batch_number])
  @@index([inventory_item_id, received_at])
  @@index([organization_id])
  @@index([supplier_id])
}

model vehicle_stock_batch {
  id          String  @id @default(uuid())
  vehicle_id  String
  vehicle     vehicle @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  batch_id    String
  batch       stock_batch @relation(fields: [batch_id], references: [id])
  qty_on_hand Decimal @default(0) @db.Decimal(10, 2)
  updated_at  DateTime @updatedAt
  created_at  DateTime @default(now())

  @@unique([vehicle_id, batch_id])
  @@index([vehicle_id])
  @@index([batch_id])
}

model stock_movement_serial {
  id             String @id @default(uuid())
  movement_id    String
  movement       stock_movement @relation(fields: [movement_id], references: [id], onDelete: Cascade)
  serial_unit_id String
  serial_unit    serial_unit    @relation(fields: [serial_unit_id], references: [id], onDelete: Cascade)

  @@unique([movement_id, serial_unit_id])
  @@index([serial_unit_id])
  @@index([movement_id])
}

model stock_movement_batch {
  id          String @id @default(uuid())
  movement_id String
  movement    stock_movement @relation(fields: [movement_id], references: [id], onDelete: Cascade)
  batch_id    String
  batch       stock_batch    @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  qty         Decimal @db.Decimal(10, 2) // strictly positive allocation

  @@unique([movement_id, batch_id])
  @@index([batch_id])
  @@index([movement_id])
}

